<tr id="<%= dom_id(item) %>">
  <td>
    <%= link_to item.name, truck_group_path(item), class: 'fw-semibold text-decoration-none text-body text-break' %>
  </td>
  <td class="d-none d-md-table-cell"><%= truck_group_axles(item) %></td>
  <td class="d-none d-lg-table-cell"><%= truck_group_plates(item) %></td>
  <td class="d-none d-md-table-cell"><%= truck_group_fuel_percentage(item.fuel_percentage) %></td>
  <td><%= truck_group_status_badge(item) %></td>
  <td class="text-end text-nowrap">
    <%= responsive_actions_menu(truck_groups_menu(item)) %>
  </td>
</tr>
