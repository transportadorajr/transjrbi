<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle') do %>
    <%= link_to_filters('#filtersModal', class: 'btn btn-outline-secondary btn-round') %>
  <% end %>

  <%= render 'filters' %>

  <div class="row g-3 mb-4">
    <%= counter_card(:dark, t('.total'), @total_count) %>
    <%= counter_card(:success, t('.valid'), @valid_count) %>
    <%= counter_card(:danger, t('.canceled'), @canceled_count) %>
  </div>

  <div class="card table-card">
    <div class="table-card-header">
      <div class="table-card-heading">
        <p class="table-card-title"><%= t('.title') %></p>
        <p class="table-card-subtitle"><%= t('shared.total_records', count: @manifests.total_count) %></p>
      </div>
      <%= sort_menu(freight_sort_columns(Atua::Manifest)) %>
    </div>
    <div class="table-card-body">
      <% if @manifests.any? %>
        <%= render 'table', collection: @manifests %>
      <% else %>
        <%= render 'shared/no_content' %>
      <% end %>
    </div>
  </div>
</div>
