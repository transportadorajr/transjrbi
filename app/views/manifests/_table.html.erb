<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= Atua::Manifest.human_attribute_name(:mdfe) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::Manifest.human_attribute_name(:plate) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Manifest.human_attribute_name(:driver) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Manifest.human_attribute_name(:origin) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Manifest.human_attribute_name(:destination) %></th>
        <th class="d-none d-xl-table-cell text-nowrap"><%= Atua::Manifest.human_attribute_name(:weight_kg) %></th>
        <th class="d-none d-xl-table-cell"><%= Atua::Manifest.human_attribute_name(:customer_group) %></th>
        <th class="d-none d-lg-table-cell text-nowrap"><%= Atua::Manifest.human_attribute_name(:loaded_km) %></th>
        <%= sortable_header(Atua::Manifest.human_attribute_name(:gross_per_km), :gross_per_km, first_direction: :desc, class: 'd-none d-md-table-cell text-nowrap') %>
        <%= manifest_net_per_km_header %>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
