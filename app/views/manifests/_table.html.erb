<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= Atua::Manifest.human_attribute_name(:number) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::Manifest.human_attribute_name(:issued_on) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::Manifest.human_attribute_name(:plate) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Manifest.human_attribute_name(:origin) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Manifest.human_attribute_name(:destination) %></th>
        <%= sortable_header(Atua::Manifest.human_attribute_name(:total_freight), :gross, first_direction: :desc, class: 'd-none d-md-table-cell') %>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
