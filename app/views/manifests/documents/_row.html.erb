<tr id="<%= dom_id(document) %>">
  <td><%= manifest_document_number(document) %></td>
  <td class="d-none d-md-table-cell text-break"><%= tax_value(document.transport_document&.taker_name) %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= manifest_km(document.loaded_km) %></td>
  <td class="text-nowrap"><%= tax_money(document.per_km(document.gross_cents)) %></td>
  <%= manifest_document_net_per_km_cell(document, net_cents_by_document) %>
</tr>
