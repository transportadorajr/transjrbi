<div class="table-responsive">
  <table class="table table-hover align-middle mb-0" id="manifest_freight_expenses">
    <thead class="table-light">
      <tr>
        <th><%= FreightExpense.human_attribute_name(:transport_document) %></th>
        <th><%= FreightExpense.human_attribute_name(:kind_type) %></th>
        <th class="d-none d-md-table-cell"><%= FreightExpense.human_attribute_name(:detail) %></th>
        <th class="d-none d-lg-table-cell text-end"><%= FreightExpense.human_attribute_name(:base) %></th>
        <th class="d-none d-md-table-cell text-end"><%= FreightExpense.human_attribute_name(:rate) %></th>
        <th class="text-end"><%= FreightExpense.human_attribute_name(:amount) %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'manifests/freight_expenses/row', collection: freight_expenses, as: :freight_expense %>
    </tbody>
  </table>
</div>
<div class="d-flex justify-content-between align-items-center border-top pt-3 mt-3" id="manifest_freight_expenses_total">
  <span class="fw-medium"><%= t('manifests.freight_expenses.total') %></span>
  <strong class="text-nowrap"><%= tax_money(total) %></strong>
</div>
