<% content_for :title, t('.title') %>

<div class="page-shell">
  <div class="mb-3 page-breadcrumb">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to t('life_insurances.index.title'), life_insurances_path %></li>
        <li class="breadcrumb-item active" aria-current="page"><%= t('.title') %></li>
      </ol>
    </nav>
    <%= page_header_tag t('.title'), back_path: life_insurances_path, back_title: t('.back'), wrapper_class: 'mb-0' %>
  </div>

  <div class="card form-card">
    <div class="form-card-header">
      <p class="form-card-title"><%= t('.exclusion_data') %></p>
      <p class="form-card-subtitle"><%= t('.exclusion_data_text', employee: @life_insurance.employee.name) %></p>
    </div>
    <%= simple_form_for(@life_insurance_exclusion_form, url: life_insurance_exclusion_path(@life_insurance), method: :post) do |f| %>
      <div class="form-card-body">
        <div class="row g-3">
          <div class="col-12 col-lg-4">
            <%= f.input :excluded_on, as: :date, html5: true, required: true, input_html: { class: 'form-control' } %>
          </div>
        </div>
      </div>

      <div class="form-card-footer">
        <%= f.button :submit, t('.submit'), class: 'btn btn-danger px-4 btn-round', data: { turbo_confirm: t('.confirm') } %>
        <%= link_to t('helpers.links.cancel'), life_insurances_path, class: 'btn btn-outline-secondary px-4 btn-round' %>
      </div>
    <% end %>
  </div>
</div>
