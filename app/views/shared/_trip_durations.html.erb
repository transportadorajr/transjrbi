<%# locals: (durations:, net:) %>

<section class="mt-4" id="trip_durations">
  <div class="row g-3">
    <%= counter_card(:primary, t('trip_durations.average'), trip_duration(durations.average)) %>
    <%= trip_durations_net_card(durations, net:) %>
    <%= counter_card(:warning, t('trip_durations.in_progress_count'), durations.in_progress_count) %>
  </div>
  <%= trip_durations_excluded_note(durations) %>
</section>
