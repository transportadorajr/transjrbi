<%# locals: (report:, plain_header: false) %>
#table(
  columns: <%= typst_columns(report.columns) %>,
  align: <%= typst_alignments(report.columns) %>,
  inset: (x: 5pt, y: 4pt),
  stroke: 0.4pt + rgb("<%= TypstHelper::TYPST_BORDER_COLOR %>"),
  fill: <%= typst_table_fill(plain_header) %>,

  <%= typst_table_header(report.columns.map(&:label), plain: plain_header) %>

  <% report.rows.each do |row| %>
    <%= typst_table_row(row) %>
  <% end %>

  <%= typst_table_footer(report.totals) %>
)
