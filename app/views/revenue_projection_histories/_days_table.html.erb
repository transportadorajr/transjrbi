<%# locals: (rows:) %>

<div class="card table-card mb-4">
  <div class="table-card-header">
    <div class="table-card-heading">
      <p class="table-card-title"><%= t('revenue_projection_histories.show.days_title') %></p>
      <p class="table-card-subtitle"><%= t('revenue_projection_histories.show.days_subtitle') %></p>
    </div>
  </div>
  <div class="table-card-body">
    <div class="table-responsive">
      <table class="table table-sm app-table align-middle mb-0" id="history_days">
        <thead>
          <tr>
            <th><%= t('revenue_projection_histories.show.date') %></th>
            <th class="text-end d-none d-sm-table-cell"><%= t('revenue_projection_histories.show.forecast') %></th>
            <th class="text-end"><%= t('revenue_projection_histories.show.billed') %></th>
            <th class="text-end d-none d-md-table-cell"><%= t('revenue_projection_histories.show.difference') %></th>
            <th class="text-end d-none d-lg-table-cell"><%= t('revenue_projection_histories.show.documents') %></th>
            <th class="text-end d-none d-lg-table-cell"><%= t('revenue_projection_histories.show.month_projection') %></th>
            <th class="text-end"><%= t('revenue_projection_histories.show.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <%= render 'day_row', row: %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
