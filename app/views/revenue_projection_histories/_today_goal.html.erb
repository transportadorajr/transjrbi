<%# locals: (goal:) %>

<div class="card detail-card mb-3" id="today_goal">
  <div class="card-body">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
      <span class="fw-semibold"><%= t('revenue_projection_histories.today_goal.title', target: goal.label) %></span>
      <%= revenue_projection_history_today_goal_badge(goal) %>
    </div>
    <div class="d-flex flex-column flex-sm-row justify-content-between gap-1 mb-2">
      <strong class="text-primary"><%= revenue_projection_history_today_goal_realized(goal) %></strong>
      <span class="text-muted"><%= revenue_projection_history_today_goal_missing(goal) %></span>
    </div>
    <%= goal_progress(goal) %>
    <div class="d-flex flex-column flex-sm-row justify-content-between gap-1 mt-2 small">
      <span class="text-muted"><%= revenue_projection_history_today_goal_projection(goal) %></span>
      <%= link_to t('revenue_projection_histories.today_goal.panel'), goals_path %>
    </div>
  </div>
</div>
