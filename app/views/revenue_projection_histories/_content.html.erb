<%# locals: (history:) %>

<%= render 'period_filters', history: %>

<div class="row g-3 mb-2" id="history_cards">
  <%= revenue_projection_history_cards(history) %>
</div>

<div class="mb-4">
  <%= revenue_projection_history_notes(history) %>
</div>

<div class="mb-4">
  <%= render 'freight_billings/chart_card', title: t(history.period_type, scope: 'revenue_projection_histories.show.chart_title'),
                                            subtitle: t(history.period_type, scope: 'revenue_projection_histories.show.chart_subtitle'),
                                            chart: revenue_projection_history_chart(history) %>
</div>

<%= revenue_projection_history_weeks(history) %>
<%= render 'days_table', history: %>
