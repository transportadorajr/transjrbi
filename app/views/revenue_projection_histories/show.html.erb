<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle') do %>
    <%= link_to_filters('#filtersModal', applied: @filter_form.filtered?, class: 'btn btn-outline-secondary btn-round') %>
    <%= revenue_projection_history_export_button(@history) %>
  <% end %>

  <%= render 'filters', filter_form: @filter_form %>
  <%= render 'period_filters', history: @history, filter_form: @filter_form %>
  <%= revenue_projection_history_cut(@cut_items) %>

  <%= revenue_projection_history_body(@history) %>
</div>
