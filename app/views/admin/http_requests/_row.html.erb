<tr id="<%= dom_id(item) %>">
  <td>
    <div class="table-identity">
      <span class="fw-semibold d-block text-break"><%= item.http_method %> <%= admin_http_request_path_label(item) %></span>
      <span class="text-muted text-small d-block d-md-none"><%= l(item.created_at, format: :short) %></span>
    </div>
  </td>
  <td class="text-nowrap"><%= admin_http_request_status_badge(item) %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= l(item.created_at, format: :short) %></td>
  <td class="d-none d-lg-table-cell"><%= item.integration_type_name %></td>
  <td class="d-none d-lg-table-cell"><%= admin_http_request_tenant(item) %></td>
  <td class="d-none d-lg-table-cell text-nowrap"><%= admin_http_request_duration(item) %></td>
  <td class="text-end text-nowrap">
    <%= responsive_actions_menu(admin_http_request_menu(item)) %>
  </td>
</tr>
