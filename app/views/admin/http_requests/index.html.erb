<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle') do %>
    <%= link_to_filters('#filtersModal', class: 'btn btn-outline-secondary btn-round') %>
  <% end %>

  <%= render 'filters' %>

  <div class="row g-3 mb-4">
    <%= counter_card(:dark, t('.total'), @total_count) %>
    <%= counter_card(:success, t('.succeeded'), @succeeded_count) %>
    <%= counter_card(:danger, t('.failed'), @failed_count) %>
  </div>

  <div class="card table-card">
    <div class="table-card-header">
      <div class="table-card-heading">
        <p class="table-card-title"><%= t('.history') %></p>
        <p class="table-card-subtitle"><%= t('shared.total_records', count: @http_requests.total_count) %></p>
      </div>
    </div>
    <div class="table-card-body">
      <% if @http_requests.any? %>
        <%= render 'table', collection: @http_requests %>
      <% else %>
        <%= render 'shared/no_content' %>
      <% end %>
    </div>
  </div>
</div>
