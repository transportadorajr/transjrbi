<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: admin_http_requests_path, method: :get do |f| %>
    <%= f.hidden_field :atua_import_id, value: params[:atua_import_id] %>

    <div class="row g-3">
      <div class="col-12">
        <%= f.label :integration_type, Admin::HttpRequest.human_attribute_name(:integration_type), class: 'form-label fw-medium' %>
        <%= f.select :integration_type,
                     Admin::HttpRequest.enum_options_for_select(:integration_type),
                     { include_blank: t('shared.all'), selected: params[:integration_type] },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :status, Admin::HttpRequest.human_attribute_name(:status_code), class: 'form-label fw-medium' %>
        <%= f.select :status,
                     Admin::HttpRequest.statuses,
                     { include_blank: t('shared.all'), selected: params[:status] },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :tenant_id, Admin::HttpRequest.human_attribute_name(:tenant), class: 'form-label fw-medium' %>
        <%= f.select :tenant_id,
                     options_from_collection_for_select(@tenants, :id, :trade_name, params[:tenant_id]),
                     { include_blank: t('shared.all') },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :url, Admin::HttpRequest.human_attribute_name(:url), class: 'form-label fw-medium' %>
        <%= f.search_field :url, value: params[:url], class: 'form-control bg-light', inputmode: :url, autocomplete: :off %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :start_date, t('admin.http_requests.filters.start_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :start_date, value: params[:start_date], class: 'form-control bg-light' %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :end_date, t('admin.http_requests.filters.end_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :end_date, value: params[:end_date], class: 'form-control bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), admin_http_requests_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
