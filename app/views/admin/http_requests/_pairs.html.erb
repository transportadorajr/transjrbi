<div class="table-responsive">
  <table class="table table-sm http-request-pairs mb-0">
    <tbody>
      <% pairs.each do |name, value| %>
        <tr>
          <th class="text-nowrap"><%= name %></th>
          <td class="text-break"><%= value %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
