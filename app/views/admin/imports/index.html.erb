<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle') do %>
    <%= link_to_filters('#filtersModal', class: 'btn btn-outline-secondary btn-round') %>
    <%= link_to new_admin_initial_load_path, class: 'btn btn-outline-primary btn-round' do %>
      <%= icon(:'cloud-download', class: 'me-2') %>
      <%= t('.initial_load') %>
    <% end %>
    <%= create_button(t('.new_import'), new_admin_import_path) %>
  <% end %>

  <%= render 'filters' %>

  <%= admin_imports_action_required(@action_required_imports) %>

  <%= render 'overview', tenant_statuses: @tenant_statuses %>

  <div class="row g-3 mb-4">
    <%= counter_card(:dark, t('.total'), @total_count, col_class: 'col-6 col-lg-3') %>
    <%= counter_card(:success, t('.succeeded'), @succeeded_count, col_class: 'col-6 col-lg-3') %>
    <%= counter_card(:danger, t('.failed'), @failed_count, col_class: 'col-6 col-lg-3') %>
    <%= counter_card(:warning, t('.running'), @running_count, col_class: 'col-6 col-lg-3') %>
  </div>

  <div class="card table-card">
    <div class="table-card-header">
      <div class="table-card-heading">
        <p class="table-card-title"><%= t('.history') %></p>
        <p class="table-card-subtitle"><%= t('shared.total_records', count: @imports.total_count) %></p>
      </div>
    </div>
    <div class="table-card-body">
      <% if @imports.any? %>
        <%= render 'table', collection: @imports %>
      <% else %>
        <%= render 'shared/no_content' %>
      <% end %>
    </div>
  </div>
</div>
