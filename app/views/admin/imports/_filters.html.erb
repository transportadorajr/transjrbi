<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: admin_imports_path, method: :get do |f| %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :tenant_id, Atua::Import.human_attribute_name(:tenant), class: 'form-label fw-medium' %>
        <%= f.select :tenant_id,
                     options_from_collection_for_select(@tenants, :id, :trade_name, params[:tenant_id]),
                     { include_blank: t('shared.all') },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :report_type, Atua::Import.human_attribute_name(:report_type), class: 'form-label fw-medium' %>
        <%= f.select :report_type,
                     admin_report_type_options,
                     { include_blank: t('shared.all'), selected: params[:report_type] },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :status, Atua::Import.human_attribute_name(:status_type), class: 'form-label fw-medium' %>
        <%= f.select :status,
                     Atua::Import.statuses,
                     { include_blank: t('shared.all'), selected: params[:status] },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12 col-sm-6">
        <%= f.label :start_date, t('admin.imports.filters.start_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :start_date, value: params[:start_date], class: 'form-control bg-light' %>
      </div>

      <div class="col-12 col-sm-6">
        <%= f.label :end_date, t('admin.imports.filters.end_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :end_date, value: params[:end_date], class: 'form-control bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), admin_imports_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
