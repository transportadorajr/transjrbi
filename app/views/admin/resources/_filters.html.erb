<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: admin_resources_path, method: :get do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :name, t('admin.resources.filters.name'), class: 'form-label fw-medium' %>
        <%= f.text_field :name, value: params[:name], class: 'form-control bg-light', placeholder: t('admin.resources.filters.name') %>
      </div>

      <div class="col-12">
        <%= f.label :slug, t('admin.resources.filters.slug'), class: 'form-label fw-medium' %>
        <%= f.text_field :slug, value: params[:slug], class: 'form-control bg-light', placeholder: t('admin.resources.filters.slug') %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), admin_resources_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
