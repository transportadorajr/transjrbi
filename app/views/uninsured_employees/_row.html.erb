<tr id="<%= dom_id(item) %>">
  <td class="fw-semibold text-break"><%= item.name %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= item.company_type_name %></td>
  <td class="d-none d-lg-table-cell text-break"><%= employee_job_position_name(item) %></td>
  <td class="d-none d-lg-table-cell text-nowrap"><%= employee_date(item.admitted_on) %></td>
  <td class="text-end text-nowrap">
    <%= responsive_actions_menu(uninsured_employees_menu(item)) %>
  </td>
</tr>
