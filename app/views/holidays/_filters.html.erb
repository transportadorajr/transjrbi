<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: holidays_path, method: :get do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :year, t('holidays.filters.year'), class: 'form-label fw-medium' %>
        <%= f.select :year, holiday_year_options(@years), {}, class: 'form-select bg-light' %>
      </div>
      <div class="col-12">
        <%= f.label :name, t('holidays.filters.name'), class: 'form-label fw-medium' %>
        <%= f.text_field :name, value: params[:name], class: 'form-control bg-light', autocomplete: :off,
                                placeholder: t('holidays.filters.name') %>
      </div>
      <div class="col-12">
        <%= f.label :scope_type, Holiday.human_attribute_name(:scope_type), class: 'form-label fw-medium' %>
        <%= f.select :scope_type, holiday_scope_type_options, { include_blank: t('holidays.filters.all_scopes') },
                     class: 'form-select bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), holidays_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
