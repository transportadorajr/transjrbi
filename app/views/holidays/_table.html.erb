<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <%= sortable_header(Holiday.human_attribute_name(:date), :date) %>
        <%= sortable_header(Holiday.human_attribute_name(:name), :name) %>
        <th class="d-none d-md-table-cell"><%= Holiday.human_attribute_name(:scope_type) %></th>
        <th class="d-none d-md-table-cell"><%= Holiday.human_attribute_name(:kind_type) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
