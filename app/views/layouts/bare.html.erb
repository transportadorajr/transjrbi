<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || 'TransJRBI' %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= render 'layouts/pwa_head' %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">

    <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload', type: 'module' %>
  </head>

  <body class="auth-body">
    <div class="auth">
      <section class="auth-hero">
        <div class="auth-hero-content">
          <span class="auth-brand">
            <span class="auth-brand-mark"><%= icon(:'truck-front-fill') %></span>
            <%= t('.brand') %>
          </span>

          <h1 class="auth-hero-title"><%= t('.hero_title') %></h1>
          <p class="auth-hero-text"><%= t('.hero_text') %></p>
        </div>
      </section>

      <section class="auth-sheet">
        <div class="auth-sheet-inner">
          <%= render 'shared/flash' %>
          <%= yield %>
        </div>
      </section>
    </div>
  </body>
</html>
