<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: job_positions_path, method: :get do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :name, JobPosition.human_attribute_name(:name), class: 'form-label fw-medium' %>
        <%= f.text_field :name, value: params[:name], class: 'form-control bg-light', autocomplete: :off,
                                placeholder: JobPosition.human_attribute_name(:name) %>
      </div>
      <div class="col-12">
        <%= f.label :status, JobPosition.human_attribute_name(:activated_at), class: 'form-label fw-medium' %>
        <%= f.select :status, job_position_status_options, { include_blank: t('shared.all') },
                     class: 'form-select bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), job_positions_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
