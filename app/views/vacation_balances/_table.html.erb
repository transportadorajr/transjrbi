<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= Vacation.human_attribute_name(:employee) %></th>
        <th class="d-none d-md-table-cell"><%= Vacation.human_attribute_name(:acquisition_start_on) %></th>
        <th class="d-none d-md-table-cell"><%= t('vacation_balances.table.deadline_on') %></th>
        <th class="d-none d-lg-table-cell text-end"><%= t('vacation_balances.table.balance') %></th>
        <th><%= t('vacation_balances.table.status') %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
