<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle', days: VacationPeriod::DUE_SOON_DAYS) do %>
    <%= link_to_filters('#filtersModal', class: 'btn btn-outline-secondary btn-round') %>
  <% end %>

  <%= render 'filters' %>

  <div class="row g-3 mb-4">
    <%= counter_card(:danger, t('.overdue'), @counts[:overdue]) %>
    <%= counter_card(:warning, t('.due_soon', days: VacationPeriod::DUE_SOON_DAYS), @counts[:due_soon]) %>
    <%= counter_card(:dark, t('.open'), @counts[:open]) %>
  </div>

  <div class="card table-card">
    <div class="table-card-header">
      <div class="table-card-heading">
        <p class="table-card-title"><%= t('.periods') %></p>
        <p class="table-card-subtitle"><%= t('shared.total_records', count: @periods.total_count) %></p>
      </div>
    </div>
    <div class="table-card-body">
      <% if @periods.any? %>
        <%= render 'table', collection: @periods %>
      <% else %>
        <%= render 'shared/no_content' %>
      <% end %>
    </div>
  </div>
</div>
