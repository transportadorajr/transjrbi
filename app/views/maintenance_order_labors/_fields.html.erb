<div class="row g-3">
  <div class="col-12 col-lg-8">
    <%= f.input :workshop_employee_id, collection: item_form.workshop_employees, label_method: :name, value_method: :id,
                                       required: true, include_blank: t('helpers.select.prompt'), input_html: { class: 'form-select bg-light' } %>
  </div>
  <div class="col-12 col-lg-4">
    <%= f.input :worked_on, as: :date, html5: true, required: true, input_html: { class: 'form-control bg-light' } %>
  </div>
  <div class="col-12 col-lg-4">
    <%= f.input :start_time, as: :time, html5: true, input_html: { class: 'form-control bg-light' } %>
  </div>
  <div class="col-12 col-lg-4">
    <%= f.input :end_time, as: :time, html5: true, input_html: { class: 'form-control bg-light' } %>
  </div>
  <div class="col-12 col-lg-4">
    <%= f.input :hours, hint: t('maintenance_order_labors.form.hours_hint'),
                        input_html: { class: 'form-control bg-light', inputmode: :decimal, autocomplete: 'off' } %>
  </div>
  <div class="col-12">
    <%= f.input :activity, as: :text, input_html: { class: 'form-control bg-light', rows: 3 } %>
  </div>
</div>
