<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle') do %>
    <%= link_to_filters('#filtersModal', class: 'btn btn-outline-secondary btn-round') %>
    <%= maintenance_order_create_button %>
  <% end %>

  <%= render 'filters' %>

  <div class="row g-3 mb-4">
    <%= counter_card(:dark, t('.pending'), @pending_count) %>
    <%= counter_card(:danger, t('.stopped'), @stopped_count) %>
    <%= counter_card(:success, t('.finished_this_month'), @finished_this_month_count) %>
  </div>

  <div class="card table-card">
    <div class="table-card-header">
      <div class="table-card-heading">
        <p class="table-card-title"><%= t('.title') %></p>
        <p class="table-card-subtitle"><%= t('shared.total_records', count: @maintenance_orders.total_count) %></p>
      </div>
      <%= sort_menu([[MaintenanceOrder.human_attribute_name(:opened_at), :opened_at, :desc]]) %>
    </div>
    <div class="table-card-body">
      <% if @maintenance_orders.any? %>
        <%= render 'table', collection: @maintenance_orders %>
      <% else %>
        <%= render 'shared/no_content' %>
      <% end %>
    </div>
  </div>
</div>
