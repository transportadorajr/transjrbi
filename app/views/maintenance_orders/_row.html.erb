<tr id="<%= dom_id(item) %>">
  <td class="fw-semibold text-nowrap"><%= link_to item.number, maintenance_order_path(item) %></td>
  <td class="text-nowrap"><%= item.plate %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= maintenance_order_opened_at(item) %></td>
  <td class="d-none d-lg-table-cell"><%= item.maintenance_type_name %></td>
  <td class="d-none d-lg-table-cell"><%= item.priority_type_name %></td>
  <td class="d-none d-lg-table-cell"><%= item.affected_system_type_name %></td>
  <td><%= maintenance_order_status_badge(item) %></td>
  <td class="text-end text-nowrap">
    <%= responsive_actions_menu(maintenance_orders_menu(item)) %>
  </td>
</tr>
