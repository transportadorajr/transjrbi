<div class="card detail-card mb-4">
  <div class="detail-card-header">
    <p class="detail-card-title"><%= t('maintenance_orders.show.signatures') %></p>
  </div>
  <div class="detail-card-body">
    <div class="row g-4" id="signatures">
      <% signatures.each do |signature| %>
        <div class="col-12 col-md-6 col-lg-4 signature">
          <%= maintenance_order_signature_image(signature) %>
          <p class="fw-semibold mb-0 mt-2 text-break"><%= signature.signer_name %></p>
          <p class="text-muted small mb-0"><%= signature.signer_role_type_name %></p>
          <p class="text-muted small mb-0"><%= maintenance_order_signature_signed_at(signature) %></p>
        </div>
      <% end %>
    </div>
    <p class="text-muted small mb-0 mt-3 text-break"><%= maintenance_order_signature_digest(signatures.first) %></p>
  </div>
</div>
