<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: maintenance_orders_path, method: :get, data: { controller: 'date-range' } do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12 col-md-6">
        <%= f.label :start_date, t('maintenance_orders.filters.start_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :start_date, value: params[:start_date], class: 'form-control bg-light',
                                      data: { date_range_target: 'start', action: 'change->date-range#openEnd' } %>
      </div>
      <div class="col-12 col-md-6">
        <%= f.label :end_date, t('maintenance_orders.filters.end_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :end_date, value: params[:end_date], class: 'form-control bg-light', data: { date_range_target: 'end' } %>
      </div>
      <div class="col-12 col-md-6">
        <%= f.label :number, MaintenanceOrder.human_attribute_name(:number), class: 'form-label fw-medium' %>
        <%= f.text_field :number, value: params[:number], class: 'form-control bg-light', autocomplete: :off, inputmode: :numeric,
                                  placeholder: MaintenanceOrder.human_attribute_name(:number) %>
      </div>
      <div class="col-12 col-md-6">
        <%= f.label :plate, MaintenanceOrder.human_attribute_name(:plate), class: 'form-label fw-medium' %>
        <%= f.text_field :plate, value: params[:plate], class: 'form-control bg-light text-uppercase', autocomplete: :off,
                                 placeholder: MaintenanceOrder.human_attribute_name(:plate) %>
      </div>
      <div class="col-12">
        <%= f.label :status_type, MaintenanceOrder.human_attribute_name(:status_type), class: 'form-label fw-medium' %>
        <%= f.select :status_type, maintenance_order_filter_options(:status_type), { include_blank: t('shared.all') },
                     class: 'form-select bg-light' %>
      </div>
      <div class="col-12">
        <%= f.label :maintenance_type, MaintenanceOrder.human_attribute_name(:maintenance_type), class: 'form-label fw-medium' %>
        <%= f.select :maintenance_type, maintenance_order_filter_options(:maintenance_type), { include_blank: t('shared.all') },
                     class: 'form-select bg-light' %>
      </div>
      <div class="col-12">
        <%= f.label :priority_type, MaintenanceOrder.human_attribute_name(:priority_type), class: 'form-label fw-medium' %>
        <%= f.select :priority_type, maintenance_order_filter_options(:priority_type), { include_blank: t('shared.all') },
                     class: 'form-select bg-light' %>
      </div>
      <div class="col-12">
        <%= f.label :affected_system_type, MaintenanceOrder.human_attribute_name(:affected_system_type), class: 'form-label fw-medium' %>
        <%= f.select :affected_system_type, maintenance_order_filter_options(:affected_system_type), { include_blank: t('shared.all') },
                     class: 'form-select bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), maintenance_orders_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
