<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: maintenance_parts_path, method: :get do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :term, t('maintenance_catalog.filters.term'), class: 'form-label fw-medium' %>
        <%= f.text_field :term, value: params[:term], class: 'form-control bg-light', autocomplete: :off,
                                placeholder: t('maintenance_catalog.filters.term_placeholder') %>
      </div>
      <div class="col-12">
        <%= f.label :status, MaintenancePart.human_attribute_name(:active), class: 'form-label fw-medium' %>
        <%= f.select :status, options_for_select(MaintenancePart.statuses, params[:status]),
                     { include_blank: t('maintenance_catalog.filters.all') }, class: 'form-select bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), maintenance_parts_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
