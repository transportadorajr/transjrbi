<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: expenses_path, method: :get do |f| %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :history, t('expenses.filters.history'), class: 'form-label fw-medium' %>
        <%= f.select :history, @histories, { include_blank: t('shared.all'), selected: params[:history] },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :payee, t('expenses.filters.payee'), class: 'form-label fw-medium' %>
        <%= f.text_field :payee, value: params[:payee], class: 'form-control bg-light', autocomplete: :off,
                                 placeholder: t('expenses.filters.payee') %>
      </div>

      <div class="col-12">
        <%= f.label :plate, t('expenses.filters.plate'), class: 'form-label fw-medium' %>
        <%= f.text_field :plate, value: params[:plate], class: 'form-control bg-light text-uppercase', autocomplete: :off,
                                 placeholder: t('expenses.filters.plate') %>
      </div>

      <div class="col-12">
        <%= f.label :allocation, t('expenses.filters.allocation'), class: 'form-label fw-medium' %>
        <%= f.select :allocation, Atua::Expense.allocations, { include_blank: t('shared.all'), selected: params[:allocation] },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :start_date, t('expenses.filters.start_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :start_date, value: params[:start_date], class: 'form-control bg-light' %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :end_date, t('expenses.filters.end_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :end_date, value: params[:end_date], class: 'form-control bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), expenses_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
