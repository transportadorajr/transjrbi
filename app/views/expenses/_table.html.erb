<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= Atua::Expense.human_attribute_name(:history_name) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::Expense.human_attribute_name(:posted_on) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Expense.human_attribute_name(:payee_name) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Expense.human_attribute_name(:plate) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Expense.human_attribute_name(:allocation) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::Expense.human_attribute_name(:total) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
