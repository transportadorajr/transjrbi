<%= tag.div class: 'row g-3', data: { controller: 'catalog-fill', catalog_fill_items_value: maintenance_order_service_catalog(item_form).to_json,
                                      action: 'change->catalog-fill#fill' } do %>
  <%= tag.div class: 'col-12', data: { catalog_fill_target: 'source' } do %>
    <%= f.label :maintenance_service_id, for: nil, id: 'maintenance_service_select_label', class: 'form-label' %>
    <%= render 'components/select2', id: 'maintenance_service_select', name: "#{f.object_name}[maintenance_service_id]",
                                     options: maintenance_catalog_options(item_form.maintenance_services), selected: item_form.maintenance_service_id,
                                     placeholder: t('maintenance_order_services.form.catalog_placeholder') %>
    <%= tag.div t('maintenance_order_services.form.catalog_hint'), class: 'form-text' %>
  <% end %>
  <div class="col-12 col-lg-6">
    <%= f.input :supplier_id, collection: item_form.suppliers, label_method: :name, value_method: :id,
                              include_blank: t('helpers.select.prompt'), hint: t('maintenance_order_services.form.supplier_hint'),
                              input_html: { class: 'form-select bg-light' } %>
  </div>
  <div class="col-12 col-lg-6">
    <%= f.input :description, required: true, input_html: { class: 'form-control bg-light', autocomplete: 'off',
                                                            data: { catalog_fill_target: 'field', catalog_fill_key: 'description' } } %>
  </div>
  <div class="col-12 col-lg-4">
    <%= f.input :quote_number, input_html: { class: 'form-control bg-light', autocomplete: 'off' } %>
  </div>
  <div class="col-12 col-lg-4">
    <%= f.input :quoted, as: :money, input_html: { class: 'form-control bg-light',
                                                   data: { catalog_fill_target: 'field', catalog_fill_key: 'price', catalog_fill_only_blank: true } } %>
  </div>
  <div class="col-12 col-lg-4">
    <%= f.input :approved, as: :money, hint: t('maintenance_order_services.form.approved_hint'), input_html: { class: 'form-control bg-light' } %>
  </div>
  <div class="col-12 col-lg-6">
    <%= f.input :approved_by_name, input_html: { class: 'form-control text-uppercase bg-light', autocomplete: 'off' } %>
  </div>
  <div class="col-12 col-lg-6">
    <%= f.input :invoice_number, input_html: { class: 'form-control bg-light', autocomplete: 'off' } %>
  </div>
<% end %>
