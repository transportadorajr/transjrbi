<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= ExcludedIssuer.human_attribute_name(:name) %></th>
        <th class="d-none d-md-table-cell"><%= ExcludedIssuer.human_attribute_name(:code) %></th>
        <th class="d-none d-lg-table-cell text-end"><%= ExcludedIssuer.human_attribute_name(:documents_count) %></th>
        <th class="d-none d-lg-table-cell text-end"><%= ExcludedIssuer.human_attribute_name(:freight) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
