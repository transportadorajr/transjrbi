<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: vacations_path, method: :get do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :name, t('vacations.filters.name'), class: 'form-label fw-medium' %>
        <%= f.text_field :name, value: params[:name], class: 'form-control bg-light', autocomplete: :off,
                                placeholder: t('vacations.filters.name') %>
      </div>
      <div class="col-12">
        <%= f.label :month, t('vacations.filters.month'), class: 'form-label fw-medium' %>
        <%= f.month_field :month, value: params[:month], class: 'form-control bg-light' %>
      </div>
      <div class="col-12">
        <%= f.label :company_type, Employee.human_attribute_name(:company_type), class: 'form-label fw-medium' %>
        <%= f.select :company_type, vacation_company_type_options, { include_blank: t('shared.all') }, class: 'form-select bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), vacations_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
