<%# locals: (freight_line:) %>

<tr id="<%= dom_id(freight_line.transport_document) %>">
  <td>
    <div class="table-identity">
      <%= driver_transport_document_number(freight_line.transport_document) %>
      <span class="text-muted text-small d-block text-break"><%= tax_value(freight_line.transport_document.taker_name) %></span>
    </div>
  </td>
  <td class="d-none d-md-table-cell text-nowrap"><%= tax_time(freight_line.issued_at) %></td>
  <td class="d-none d-lg-table-cell"><%= transport_document_route(freight_line.transport_document) %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= tax_value(freight_line.transport_document.plate) %></td>
  <td class="d-none d-lg-table-cell text-break"><%= tax_value(freight_line.transport_document.driver_name) %></td>
  <td class="text-end text-nowrap"><%= tax_money(freight_line.transport_document.freight) %></td>
  <td class="d-none d-md-table-cell text-end text-nowrap"><%= freight_money(freight_line.net_cents) %></td>
  <td class="text-end text-nowrap"><%= tax_money(freight_line.gross_per_km) %></td>
  <td class="d-none d-md-table-cell text-end text-nowrap"><%= tax_money(freight_line.net_per_km) %></td>
</tr>
