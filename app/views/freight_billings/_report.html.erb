<%# locals: (dashboard:) %>

<div class="row g-3 mb-4">
  <div class="col-12 col-xl-7">
    <%= render 'chart_card', title: freight_billing_ranking_title(dashboard), subtitle: t('freight_billings.show.ranking_subtitle'),
                             chart: freight_billing_ranking_chart(dashboard) %>
  </div>

  <div class="col-12 col-xl-5">
    <%= freight_billing_evolution_cards(dashboard) %>
  </div>
</div>

<%= freight_billing_per_km_ranking_card(dashboard) %>

<div class="card table-card" id="freight_billing_table">
  <div class="table-card-header">
    <div class="table-card-heading">
      <p class="table-card-title"><%= freight_billing_table_title(dashboard) %></p>
    </div>
  </div>
  <div class="table-card-body">
    <%= render 'table', dashboard:, rows: @rows %>
  </div>
</div>
