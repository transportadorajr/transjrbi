<%# locals: (dashboard:, rows:) %>

<div class="table-responsive">
  <table class="table app-table freight-billing-table align-middle mb-0">
    <thead>
      <tr>
        <%= sortable_header(freight_billing_dimension_label(dashboard.dimension), :label, anchor: 'freight_billing_table') %>
        <%= sortable_header(t('freight_billings.columns.gross'), :gross, first_direction: :desc, anchor: 'freight_billing_table', class: 'text-end') %>
        <%= sortable_header(t('freight_billings.columns.net'), :net, first_direction: :desc, anchor: 'freight_billing_table', class: 'text-end') %>
        <th class="text-end"><%= t('freight_billings.columns.share') %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'row', collection: rows, as: :row %>
    </tbody>
    <tfoot>
      <%= render 'row', row: dashboard.total %>
    </tfoot>
  </table>
</div>

<div class="table-pagination">
  <%= paginate rows, params: { anchor: 'freight_billing_table' } %>
</div>
