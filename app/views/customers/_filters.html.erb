<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: customers_path, method: :get do |f| %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :name, t('customers.filters.name'), class: 'form-label fw-medium' %>
        <%= f.text_field :name, value: params[:name], class: 'form-control bg-light', autocomplete: :off,
                                placeholder: t('customers.filters.name') %>
      </div>

      <div class="col-12">
        <%= f.label :document, t('customers.filters.document'), class: 'form-label fw-medium' %>
        <%= f.text_field :document, value: params[:document], class: 'form-control bg-light', inputmode: :numeric, autocomplete: :off,
                                    placeholder: t('customers.filters.document'),
                                    data: { controller: 'mask', mask_pattern_value: %w[000.000.000-00 00.000.000/0000-00] } %>
      </div>

      <div class="col-12">
        <%= f.label :city, t('customers.filters.city'), class: 'form-label fw-medium' %>
        <%= f.text_field :city, value: params[:city], class: 'form-control bg-light', autocomplete: :off,
                                placeholder: t('customers.filters.city') %>
      </div>

      <div class="col-12">
        <%= f.label :customer_group, t('customers.filters.customer_group'), class: 'form-label fw-medium' %>
        <%= f.collection_select :customer_group, @customer_groups, :id, :name,
                                { include_blank: t('shared.all'), selected: params[:customer_group] },
                                { class: 'form-select bg-light' } %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), customers_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
