<tr id="<%= dom_id(item) %>">
  <td>
    <div class="table-identity">
      <%= link_to tax_value(item.name), customer_path(item), class: 'fw-semibold text-decoration-none text-body text-break' %>
      <span class="text-muted text-small d-block text-break"><%= tax_value(item.trade_name) %></span>
    </div>
  </td>
  <td class="d-none d-md-table-cell text-break"><%= customer_group_name(item) %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= tax_value(item.document) %></td>
  <td class="d-none d-lg-table-cell"><%= tax_city(item.city, item.state) %></td>
  <td class="d-none d-lg-table-cell"><%= tax_value(item.activity) %></td>
  <td class="text-end text-nowrap">
    <%= responsive_actions_menu(customers_menu(item)) %>
  </td>
</tr>
