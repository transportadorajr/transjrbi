<tr id="<%= dom_id(item) %>">
  <td>
    <%= link_to item.name, export_shortcut_path(item), class: 'fw-semibold text-decoration-none text-body text-break' %>
  </td>
  <td class="d-none d-md-table-cell text-break"><%= export_shortcut_customer_group(item) %></td>
  <td class="d-none d-lg-table-cell text-break"><%= export_shortcut_plants(item) %></td>
  <td class="d-none d-lg-table-cell text-break"><%= export_shortcut_countries(item) %></td>
  <td class="d-none d-md-table-cell text-end"><%= item.position %></td>
  <td><%= export_shortcut_status_badge(item) %></td>
  <td class="text-end text-nowrap">
    <%= responsive_actions_menu(export_shortcuts_menu(item)) %>
  </td>
</tr>
