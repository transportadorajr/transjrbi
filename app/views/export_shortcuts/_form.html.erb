<div class="card form-card">
  <div class="form-card-header">
    <p class="form-card-title"><%= t('export_shortcuts.form.export_shortcut_data') %></p>
    <p class="form-card-subtitle"><%= t('export_shortcuts.form.export_shortcut_data_text') %></p>
  </div>
  <%= simple_form_for(export_shortcut_form, url: export_shortcut_form_url(export_shortcut_form)) do |f| %>
    <div class="form-card-body">
      <div class="row g-3">
        <div class="col-12 col-lg-8">
          <%= f.input :name, required: true, hint: t('export_shortcuts.form.name_hint'), input_html: { class: 'form-control', autocomplete: 'off' } %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.input :position, as: :integer, required: true, hint: t('export_shortcuts.form.position_hint'),
                                 input_html: { class: 'form-control', inputmode: 'numeric', min: 0 } %>
        </div>
        <div class="col-12 col-lg-6">
          <%= f.input :customer_group_id, collection: export_shortcut_form.customer_groups, label_method: :name, value_method: :id,
                                          required: false, include_blank: t('export_shortcuts.form.any_customer_group'),
                                          hint: t('export_shortcuts.form.customer_group_hint'), input_html: { class: 'form-select' } %>
        </div>
        <div class="col-12">
          <%= f.input :export_plant_ids,
                      as: :check_boxes,
                      required: false,
                      collection: export_shortcut_plant_options(export_shortcut_form),
                      hint: t('export_shortcuts.form.export_plants_hint'),
                      item_wrapper_class: 'form-check form-check-inline',
                      input_html: { class: 'form-check-input' } %>
        </div>
        <div class="col-12">
          <%= f.input :countries,
                      as: :check_boxes,
                      required: false,
                      collection: export_shortcut_country_options,
                      hint: t('export_shortcuts.form.countries_hint'),
                      item_wrapper_class: 'form-check form-check-inline',
                      input_html: { class: 'form-check-input' } %>
        </div>
        <div class="col-12">
          <%= f.input :active,
                      as: :boolean,
                      hint: t('export_shortcuts.form.active_hint'),
                      input_html: { class: 'form-check-input me-2' } %>
        </div>
      </div>
    </div>

    <div class="form-card-footer">
      <%= f.button :submit, export_shortcut_form_submit_label(export_shortcut_form),
                   class: 'btn btn-primary btn-primary-action px-4 btn-round' %>
      <%= link_to t('helpers.links.cancel'), export_shortcuts_path, class: 'btn btn-outline-secondary px-4 btn-round' %>
    </div>
  <% end %>
</div>
