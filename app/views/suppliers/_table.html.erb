<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <%= sortable_header(Supplier.human_attribute_name(:name), :name) %>
        <th class="d-none d-md-table-cell"><%= Supplier.human_attribute_name(:document) %></th>
        <th><%= Supplier.human_attribute_name(:active) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
