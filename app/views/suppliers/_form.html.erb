<div class="card form-card">
  <div class="form-card-header">
    <p class="form-card-title"><%= t('suppliers.form.supplier_data') %></p>
    <p class="form-card-subtitle"><%= t('suppliers.form.supplier_data_text') %></p>
  </div>
  <%= simple_form_for(supplier_form, url: supplier_form_url(supplier_form)) do |f| %>
    <div class="form-card-body">
      <div class="row g-3">
        <div class="col-12 col-lg-8">
          <%= f.input :name, required: true, input_html: { class: 'form-control text-uppercase', autocomplete: 'off' } %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.input :document, input_html: { class: 'form-control', inputmode: :numeric, autocomplete: 'off',
                                               data: { controller: 'mask', mask_pattern_value: %w[000.000.000-00 00.000.000/0000-00] } } %>
        </div>
        <div class="col-12">
          <%= f.input :active,
                      as: :boolean,
                      hint: t('suppliers.form.active_hint'),
                      input_html: { class: 'form-check-input me-2' } %>
        </div>
      </div>
    </div>

    <div class="form-card-footer">
      <%= f.button :submit, supplier_form_submit_label(supplier_form), class: 'btn btn-primary btn-primary-action px-4 btn-round' %>
      <%= link_to t('helpers.links.cancel'), suppliers_path, class: 'btn btn-outline-secondary px-4 btn-round' %>
    </div>
  <% end %>
</div>
