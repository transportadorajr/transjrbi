<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: vehicle_availability_path, method: :get do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :plate, t('vehicle_availabilities.filters.plate'), class: 'form-label fw-medium' %>
        <%= f.text_field :plate, value: params[:plate], class: 'form-control bg-light text-uppercase', autocomplete: :off,
                                 placeholder: t('vehicle_availabilities.filters.plate') %>
      </div>

      <div class="col-12">
        <%= f.label :kind, t('vehicle_availabilities.filters.kind'), class: 'form-label fw-medium' %>
        <%= f.select :kind, vehicle_availability_filter_options(Atua::Vehicle.fleet_kinds, :kind), { include_blank: t('shared.all') },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :availability, t('vehicle_availabilities.filters.availability'), class: 'form-label fw-medium' %>
        <%= f.select :availability, vehicle_availability_filter_options(Atua::Vehicle.availabilities, :availability),
                     { include_blank: t('shared.all') }, { class: 'form-select bg-light' } %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), vehicle_availability_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
