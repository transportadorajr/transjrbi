<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle') do %>
    <%= link_to_filters('#filtersModal', class: 'btn btn-outline-secondary btn-round') %>
  <% end %>

  <%= render 'filters' %>

  <div class="row g-3 mb-4">
    <%= counter_card(:dark, t('.total'), @total_count) %>
    <%= counter_card(:success, t('.available'), @total_count - @in_maintenance_count) %>
    <%= counter_card(:danger, t('.in_maintenance'), @in_maintenance_count) %>
  </div>

  <div class="card table-card">
    <div class="table-card-header">
      <div class="table-card-heading">
        <p class="table-card-title"><%= t('.vehicles') %></p>
        <p class="table-card-subtitle"><%= t('shared.total_records', count: @vehicles.total_count) %></p>
      </div>
    </div>
    <div class="table-card-body">
      <% if @vehicles.any? %>
        <%= render 'table', collection: @vehicles, pending_orders: @pending_orders %>
      <% else %>
        <%= render 'shared/no_content' %>
      <% end %>
    </div>
  </div>
</div>
