<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= TonnageRate.human_attribute_name(:origin) %></th>
        <th class="d-none d-md-table-cell"><%= TonnageRate.human_attribute_name(:name) %></th>
        <th class="d-none d-lg-table-cell"><%= TonnageRate.human_attribute_name(:customer_group) %></th>
        <th class="d-none d-md-table-cell"><%= TonnageRate.human_attribute_name(:valid_month) %></th>
        <th class="d-none d-lg-table-cell"><%= TonnageRate.human_attribute_name(:reference_month) %></th>
        <th class="d-none d-md-table-cell text-end"><%= TonnageRate.human_attribute_name(:rate) %></th>
        <th><%= TonnageRate.human_attribute_name(:status) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
