<%# locals: (trips:) %>

<div class="alert alert-warning mb-4" role="alert" id="unmeasured_trips">
  <p class="fw-semibold mb-1"><%= t('trips.unmeasured_alert.title', count: trips.size) %></p>
  <p class="mb-2"><%= t('trips.unmeasured_alert.text', max: number_with_delimiter(Dashboard::Trip::MAX_LOADED_KM)) %></p>
  <ul class="mb-0 ps-3">
    <% trips.each do |trip| %>
      <li><%= trips_unmeasured_item(trip) %></li>
    <% end %>
  </ul>
</div>
