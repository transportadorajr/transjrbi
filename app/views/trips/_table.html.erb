<%# locals: (dashboard:, rows:, highlights:) %>

<div class="table-responsive">
  <table class="table app-table trips-table align-middle mb-0">
    <thead>
      <tr>
        <%= sortable_header(trips_dimension_label(dashboard.dimension), :label, anchor: 'trips_table') %>
        <%= sortable_header(t('trips.columns.gross'), :gross, first_direction: :desc, anchor: 'trips_table', class: 'text-end') %>
        <%= sortable_header(t('trips.columns.gross_per_km'), :gross_per_km, first_direction: :desc, anchor: 'trips_table', class: 'd-none d-md-table-cell text-end') %>
        <%= sortable_header(t('trips.columns.net_per_km'), :net_per_km, first_direction: :desc, anchor: 'trips_table', class: 'text-end') %>
        <%= sortable_header(t('trips.columns.duration'), :duration, anchor: 'trips_table', class: 'd-none d-md-table-cell text-end') %>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'row', collection: rows, as: :row, locals: { highlights: } %>
    </tbody>
    <tfoot>
      <%= render 'row', row: dashboard.table_total %>
    </tfoot>
  </table>
</div>

<div class="table-pagination">
  <%= paginate rows, params: { anchor: 'trips_table' } %>
</div>
