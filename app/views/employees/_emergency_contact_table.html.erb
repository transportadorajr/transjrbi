<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= EmergencyContact.human_attribute_name(:name) %></th>
        <th class="d-none d-md-table-cell"><%= EmergencyContact.human_attribute_name(:relationship_type) %></th>
        <th><%= EmergencyContact.human_attribute_name(:phone) %></th>
        <th class="d-none d-lg-table-cell"><%= EmergencyContact.human_attribute_name(:notes) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'employees/emergency_contact_row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection, param_name: :emergency_contacts_page %>
</div>
