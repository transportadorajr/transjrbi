<tr id="<%= dom_id(empty_leg) %>">
  <td class="text-nowrap"><%= tax_date(empty_leg.next_manifest&.trip_on) %></td>
  <td class="text-nowrap fw-semibold"><%= empty_leg.plate %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= empty_leg_manifest_link(empty_leg.next_manifest, empty_leg.next_manifest_code) %></td>
  <td class="d-none d-lg-table-cell text-break"><%= empty_leg_location(empty_leg.origin) %></td>
  <td class="d-none d-md-table-cell text-break"><%= empty_leg_location(empty_leg.destination) %></td>
  <td class="d-none d-md-table-cell"><%= empty_leg_loading_macro_region(empty_leg) %></td>
  <td class="text-end text-nowrap fw-semibold"><%= empty_leg_distance(empty_leg) %></td>
</tr>
