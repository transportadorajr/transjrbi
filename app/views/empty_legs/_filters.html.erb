<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: empty_legs_path, method: :get, data: { controller: 'date-range' } do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12 col-lg-6">
        <%= f.label :start_date, t('empty_legs.filters.start_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :start_date, value: @start_date, class: 'form-control bg-light',
                                      data: { date_range_target: 'start', action: 'change->date-range#openEnd' } %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :end_date, t('empty_legs.filters.end_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :end_date, value: params[:end_date], class: 'form-control bg-light', data: { date_range_target: 'end' } %>
      </div>

      <div class="col-12">
        <%= f.label :plate, t('empty_legs.filters.plate'), class: 'form-label fw-medium' %>
        <%= f.text_field :plate, value: params[:plate], class: 'form-control bg-light text-uppercase', autocomplete: :off,
                                 placeholder: t('empty_legs.filters.plate') %>
      </div>

      <div class="col-12">
        <%= f.label :macro_region_id, t('empty_legs.filters.macro_region_id'), class: 'form-label fw-medium' %>
        <%= f.select :macro_region_id, empty_leg_macro_region_options(@macro_regions), { include_blank: t('shared.all') },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :customer_group_id, t('empty_legs.filters.customer_group_id'), class: 'form-label fw-medium' %>
        <%= f.select :customer_group_id, empty_leg_customer_group_options(@customer_groups), { include_blank: t('shared.all') },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :min_distance, t('empty_legs.filters.min_distance'), class: 'form-label fw-medium' %>
        <%= f.number_field :min_distance, value: params[:min_distance], class: 'form-control bg-light', min: 0, step: 1, inputmode: :numeric,
                                          placeholder: t('empty_legs.filters.min_distance') %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), empty_legs_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
