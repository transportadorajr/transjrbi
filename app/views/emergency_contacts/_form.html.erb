<div class="card form-card">
  <div class="form-card-header">
    <p class="form-card-title"><%= t('emergency_contacts.form.emergency_contact_data') %></p>
    <p class="form-card-subtitle"><%= t('emergency_contacts.form.emergency_contact_data_text', employee: emergency_contact_form.employee.name) %></p>
  </div>
  <%= simple_form_for(emergency_contact_form, url: emergency_contact_form_url(emergency_contact_form)) do |f| %>
    <div class="form-card-body">
      <div class="row g-3">
        <div class="col-12 col-lg-6">
          <%= f.input :name, input_html: { class: 'form-control', autocomplete: :off } %>
        </div>
        <div class="col-12 col-lg-6">
          <%= f.input :relationship_type, as: :select, collection: emergency_contact_relationship_options,
                                          include_blank: t('helpers.select.prompt'), input_html: { class: 'form-select' } %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.input :phone, as: :tel, required: true, hint: t('emergency_contacts.form.phone_hint'),
                              input_html: { class: 'form-control', inputmode: :tel, autocomplete: :off,
                                            value: emergency_contact_phone(emergency_contact_form.phone),
                                            data: { controller: 'mask', mask_pattern_value: EmergencyContactsHelper::PHONE_MASK } } %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.input :secondary_phone, as: :tel,
                                        input_html: { class: 'form-control', inputmode: :tel, autocomplete: :off,
                                                      value: emergency_contact_phone(emergency_contact_form.secondary_phone),
                                                      data: { controller: 'mask', mask_pattern_value: EmergencyContactsHelper::PHONE_MASK } } %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.input :position, as: :integer, hint: t('emergency_contacts.form.position_hint'),
                                 input_html: { class: 'form-control', min: 1, inputmode: :numeric } %>
        </div>
        <div class="col-12">
          <%= f.input :notes, as: :text, input_html: { class: 'form-control', rows: 3 } %>
        </div>
      </div>
    </div>

    <div class="form-card-footer">
      <%= f.button :submit, emergency_contact_form_submit_label(emergency_contact_form),
                   class: 'btn btn-primary btn-primary-action px-4 btn-round' %>
      <%= link_to t('helpers.links.cancel'), employee_path(emergency_contact_form.employee), class: 'btn btn-outline-secondary px-4 btn-round' %>
    </div>
  <% end %>
</div>
