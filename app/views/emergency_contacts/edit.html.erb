<% content_for :title, t('.title') %>

<div class="page-shell">
  <div class="mb-3 page-breadcrumb">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to t('employees.index.title'), employees_path %></li>
        <li class="breadcrumb-item"><%= link_to @emergency_contact_form.employee.name, employee_path(@emergency_contact_form.employee) %></li>
        <li class="breadcrumb-item active" aria-current="page"><%= t('.title') %></li>
      </ol>
    </nav>
    <%= page_header_tag t('.title'), back_path: employee_path(@emergency_contact_form.employee), back_title: t('.back'), wrapper_class: 'mb-0' %>
  </div>

  <%= render 'form', emergency_contact_form: @emergency_contact_form %>
</div>
