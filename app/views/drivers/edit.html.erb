<% content_for :title, t('.title') %>

<div class="page-shell">
  <div class="mb-3 page-breadcrumb">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to t('drivers.index.title'), drivers_path %></li>
        <li class="breadcrumb-item"><%= link_to tax_value(@driver.driver_name), driver_path(@driver.driver_code) %></li>
        <li class="breadcrumb-item active" aria-current="page"><%= t('.title') %></li>
      </ol>
    </nav>
    <%= page_header_tag t('.title'), subtitle: tax_value(@driver.driver_name), back_path: driver_path(@driver.driver_code),
                                     back_title: t('.back'), wrapper_class: 'mb-0' %>
  </div>

  <%= render 'form', driver_form: @driver_form %>
</div>
