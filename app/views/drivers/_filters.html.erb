<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: drivers_path, method: :get do |f| %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :name, t('drivers.filters.name'), class: 'form-label fw-medium' %>
        <%= f.text_field :name, value: params[:name], class: 'form-control bg-light', autocomplete: :off,
                                placeholder: t('drivers.filters.name') %>
      </div>

      <div class="col-12">
        <%= f.label :document, t('drivers.filters.document'), class: 'form-label fw-medium' %>
        <%= f.text_field :document, value: params[:document], class: 'form-control bg-light', inputmode: :numeric, autocomplete: :off,
                                    placeholder: t('drivers.filters.document'),
                                    data: { controller: 'mask', mask_pattern_value: %w[000.000.000-00] } %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), drivers_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
