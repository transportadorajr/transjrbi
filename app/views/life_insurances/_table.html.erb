<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <%= sortable_header(LifeInsurance.human_attribute_name(:employee), :employee_name) %>
        <th class="d-none d-md-table-cell"><%= LifeInsurancePolicy.human_attribute_name(:company_type) %></th>
        <%= sortable_header(LifeInsurance.human_attribute_name(:capital), :capital, first_direction: :desc, class: 'd-none d-md-table-cell text-end') %>
        <th class="d-none d-lg-table-cell text-end"><%= LifeInsurance.human_attribute_name(:spouse_death) %></th>
        <th class="d-none d-lg-table-cell text-end"><%= LifeInsurance.human_attribute_name(:children_death) %></th>
        <th class="d-none d-lg-table-cell text-end"><%= LifeInsurance.human_attribute_name(:funeral_assistance) %></th>
        <%= sortable_header(LifeInsurance.human_attribute_name(:premium), :premium, first_direction: :desc, class: 'text-end') %>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
