<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle') do %>
    <%= link_to_filters('#filtersModal', class: 'btn btn-outline-secondary btn-round') %>
    <%= pdf_export_button %>
    <%= xlsx_export_button %>
    <%= life_insurance_policies_button %>
  <% end %>

  <%= render 'filters' %>

  <div class="row g-3 mb-4">
    <%= life_insurance_counters(@premium_totals) %>
  </div>

  <div class="card table-card">
    <div class="table-card-header">
      <div class="table-card-heading">
        <p class="table-card-title"><%= t('.insured_employees') %></p>
        <p class="table-card-subtitle"><%= t('shared.total_records', count: @life_insurances.total_count) %></p>
      </div>
      <%= sort_menu([[LifeInsurance.human_attribute_name(:capital), :capital, :desc]]) %>
    </div>
    <div class="table-card-body">
      <% if @life_insurances.any? %>
        <%= render 'table', collection: @life_insurances %>
      <% else %>
        <%= render 'shared/no_content' %>
      <% end %>
    </div>
  </div>
</div>
