<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: life_insurances_path, method: :get do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :name, t('life_insurances.filters.name'), class: 'form-label fw-medium' %>
        <%= f.text_field :name, value: params[:name], class: 'form-control bg-light', autocomplete: :off,
                                placeholder: t('life_insurances.filters.name') %>
      </div>
      <div class="col-12">
        <%= f.label :company_type, LifeInsurancePolicy.human_attribute_name(:company_type), class: 'form-label fw-medium' %>
        <%= f.select :company_type, life_insurance_company_type_options, { include_blank: t('shared.all') }, class: 'form-select bg-light' %>
      </div>
      <div class="col-12">
        <%= f.label :employee_status, t('life_insurances.filters.employee_status'), class: 'form-label fw-medium' %>
        <%= f.select :employee_status, life_insurance_employee_status_options, { include_blank: t('shared.all') }, class: 'form-select bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), life_insurances_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
