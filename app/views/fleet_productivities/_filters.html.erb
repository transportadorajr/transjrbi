<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: fleet_productivity_path, method: :get, data: { controller: 'date-range' } do |f| %>
    <div class="row g-3">
      <div class="col-12 col-lg-6">
        <%= f.label :start_date, FleetProductivityFilterForm.human_attribute_name(:start_date), class: 'form-label fw-medium' %>
        <%= f.date_field :start_date, value: @filter_form.start_date, class: 'form-control bg-light',
                                      data: { date_range_target: 'start', action: 'change->date-range#openEnd' } %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :end_date, FleetProductivityFilterForm.human_attribute_name(:end_date), class: 'form-label fw-medium' %>
        <%= f.date_field :end_date, value: @filter_form.end_date, class: 'form-control bg-light', data: { date_range_target: 'end' } %>
      </div>

      <div class="col-12">
        <%= f.label :plate, FleetProductivityFilterForm.human_attribute_name(:plate), class: 'form-label fw-medium' %>
        <%= f.text_field :plate, value: @filter_form.plate, class: 'form-control bg-light text-uppercase', autocomplete: :off,
                                 placeholder: FleetProductivityFilterForm.human_attribute_name(:plate) %>
      </div>

      <div class="col-12">
        <%= f.label :customer_group_id, FleetProductivityFilterForm.human_attribute_name(:customer_group_id), class: 'form-label fw-medium' %>
        <%= f.select :customer_group_id, fleet_productivity_customer_group_options(@customer_groups),
                     { include_blank: t('shared.all'), selected: @filter_form.customer_group_id }, { class: 'form-select bg-light' } %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), fleet_productivity_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
