<%# locals: (route:) %>

<tr>
  <td class="text-break fw-semibold"><%= route.label %></td>
  <td class="text-end text-nowrap"><%= route.legs_count %></td>
  <td class="d-none d-md-table-cell text-end text-nowrap"><%= fleet_productivity_km(route.average_km) %></td>
  <td class="text-end text-nowrap fw-semibold"><%= fleet_productivity_km(route.total_km) %></td>
</tr>
