<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <%= sortable_header(City.human_attribute_name(:name), :name) %>
        <%= sortable_header(City.human_attribute_name(:state), :state) %>
        <th class="d-none d-md-table-cell"><%= City.human_attribute_name(:macro_region) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
