<div class="alert alert-warning mb-4" role="alert" id="unassigned_origins">
  <p class="fw-semibold mb-1"><%= t('cities.unassigned_origins_alert.title', count: origins.size) %></p>
  <p class="mb-2"><%= t('cities.unassigned_origins_alert.text') %></p>
  <ul class="mb-0 ps-3">
    <% origins.each do |(city, state), count| %>
      <li>
        <%= tax_city(city, state) %>
        <span class="text-body-secondary"><%= t('cities.unassigned_origins_alert.documents', count:) %></span>
      </li>
    <% end %>
  </ul>
</div>
