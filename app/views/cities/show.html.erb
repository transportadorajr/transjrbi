<% content_for :title, @city.name %>

<div class="page-shell">
  <div class="mb-3 page-breadcrumb">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to t('cities.index.title'), cities_path %></li>
        <li class="breadcrumb-item active" aria-current="page"><%= @city.name %></li>
      </ol>
    </nav>
    <%= page_header_tag @city.name, back_path: cities_path, back_title: t('.back'), wrapper_class: 'mb-0' do %>
      <%= city_edit_button(@city) %>
    <% end %>
  </div>

  <div class="card detail-card">
    <div class="detail-card-header">
      <p class="detail-card-title"><%= t('.city_data') %></p>
    </div>
    <div class="detail-card-body">
      <dl class="row detail-list mb-0" id="city_data">
        <dt class="col-12 col-md-3"><%= City.human_attribute_name(:name) %></dt>
        <dd class="col-12 col-md-9 text-break"><%= @city.name %></dd>

        <dt class="col-12 col-md-3"><%= City.human_attribute_name(:state) %></dt>
        <dd class="col-12 col-md-9"><%= @city.state %></dd>

        <dt class="col-12 col-md-3"><%= City.human_attribute_name(:macro_region) %></dt>
        <dd class="col-12 col-md-9 text-break"><%= city_macro_region_name(@city) %></dd>
      </dl>
    </div>
  </div>
</div>
