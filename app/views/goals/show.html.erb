<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle'), note: freight_billing_last_sync_label(@last_synced_at) do %>
    <%= xlsx_export_button %>
    <%= goal_registration_button(@dashboard.month) %>
  <% end %>

  <%= goal_month_nav(@dashboard.month, :goals_path) %>
  <%= goal_dimension_bar(@filter_form) %>
  <%= goal_missing_note(@dashboard) %>

  <%= goal_company_gauges(@dashboard) %>

  <div class="row g-2 g-md-3 mb-3 counter-grid-compact" id="goal_company_cards">
    <%= goal_company_cards(@dashboard) %>
  </div>

  <div class="mb-4">
    <%= goal_progress(@dashboard.company) %>
    <%= tag.p goal_pace_note(@dashboard), class: 'small text-muted mb-0 mt-2', id: 'goal_pace_note' %>
  </div>

  <%= goal_week(@dashboard) %>

  <div class="mb-4" id="goal_chart">
    <%= render 'freight_billings/chart_card', title: t('.chart_title'), subtitle: t('.chart_subtitle'), chart: goal_chart(@dashboard) %>
  </div>

  <%= goal_dimension_gauges(@filter_form.section, @gauge_rows) %>

  <%= render 'goals/dimension_card', dashboard: @dashboard, section: @filter_form.section, rows: @rows %>

  <%= goal_truck_groups(@truck_group_averages, @truck_group_rows) %>
</div>
