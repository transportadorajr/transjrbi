<%# locals: (section:, rows:) %>

<div class="card table-card mb-4" id="goal_<%= section %>_gauges">
  <div class="table-card-header">
    <div class="table-card-heading">
      <p class="table-card-title"><%= t(section, scope: 'goals.show.gauges.titles') %></p>
      <p class="table-card-subtitle"><%= t('goals.show.gauges.subtitle') %></p>
    </div>
  </div>
  <div class="table-card-body p-3">
    <div class="row g-2 g-md-3">
      <% rows.each do |row| %>
        <div class="col-12 col-md-6 col-xl-4">
          <%= goal_month_gauge(row, id: "goal_gauge_#{row.key}", title: row.label) %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="table-pagination">
    <%= paginate rows, param_name: :gauges_page %>
  </div>
</div>
