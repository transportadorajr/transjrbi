<%# locals: (section:, rows:, extra_row:, month:) %>

<div class="table-responsive">
  <table class="table app-table align-middle mb-0" id="goal_<%= section %>_table">
    <thead>
      <tr>
        <th><%= t(section, scope: 'goals.sections') %></th>
        <th class="text-end text-nowrap d-none d-md-table-cell"><%= t('goals.show.columns.goal') %></th>
        <th class="text-end text-nowrap d-none d-md-table-cell"><%= t('goals.show.columns.realized') %></th>
        <th class="text-end"><%= t('goals.show.columns.ratio') %></th>
        <th class="text-end text-nowrap d-none d-xl-table-cell"><%= t('goals.show.columns.week_goal') %></th>
        <th class="text-end text-nowrap d-none d-xl-table-cell"><%= t('goals.show.columns.week_realized') %></th>
        <th class="text-end text-nowrap d-none d-md-table-cell"><%= t('goals.show.columns.week_ratio') %></th>
        <th class="text-end"><%= t('goals.show.columns.status') %></th>
        <th class="text-end"><%= t('goals.show.columns.projections') %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'goals/breakdown_row', collection: rows, as: :row, locals: { month: } %>
      <%= goal_breakdown_extra_row(extra_row, month) %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate rows %>
</div>
