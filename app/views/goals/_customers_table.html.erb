<%# locals: (rows:, ungrouped_row:, month:) %>

<div class="table-responsive">
  <table class="table app-table align-middle mb-0" id="goal_customers_table">
    <thead>
      <tr>
        <th><%= t('goals.show.columns.customer_group') %></th>
        <th class="text-end d-none d-md-table-cell"><%= t('goals.show.columns.goal') %></th>
        <th class="text-end d-none d-md-table-cell"><%= t('goals.show.columns.realized') %></th>
        <th class="text-end"><%= t('goals.show.columns.ratio') %></th>
        <th class="text-end d-none d-lg-table-cell"><%= t('goals.show.columns.week_goal') %></th>
        <th class="text-end d-none d-lg-table-cell"><%= t('goals.show.columns.week_realized') %></th>
        <th class="text-end d-none d-md-table-cell"><%= t('goals.show.columns.week_ratio') %></th>
        <th class="text-end"><%= t('goals.show.columns.status') %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'goals/customer_row', collection: rows, as: :row, locals: { month: } %>
      <%= render('goals/customer_row', row: ungrouped_row, month:) if ungrouped_row %>
    </tbody>
  </table>
</div>
