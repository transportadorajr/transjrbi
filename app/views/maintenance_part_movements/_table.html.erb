<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= MaintenancePartMovement.human_attribute_name(:moved_on) %></th>
        <th><%= MaintenancePartMovement.human_attribute_name(:maintenance_part) %></th>
        <th class="d-none d-md-table-cell"><%= MaintenancePartMovement.human_attribute_name(:movement_type) %></th>
        <th class="text-end"><%= MaintenancePartMovement.human_attribute_name(:quantity) %></th>
        <th class="d-none d-md-table-cell text-end"><%= MaintenancePartMovement.human_attribute_name(:balance) %></th>
        <th class="d-none d-lg-table-cell"><%= MaintenancePartMovement.human_attribute_name(:origin) %></th>
        <th class="d-none d-lg-table-cell"><%= MaintenancePartMovement.human_attribute_name(:created_by) %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
