<%# locals: (customer_groups:) %>

<div class="table-responsive">
  <table class="table app-table align-middle mb-0" id="revenue_goals_customer_groups">
    <thead>
      <tr>
        <th><%= RevenueGoalsForm::CustomerGroupLine.human_attribute_name(:name) %></th>
        <th class="text-end"><%= RevenueGoalsForm::CustomerGroupLine.human_attribute_name(:amount) %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'revenue_goals/customer_group_row', collection: customer_groups, as: :customer_group %>
    </tbody>
  </table>
</div>
