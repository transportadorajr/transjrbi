<%# locals: (revenue_goals_form:, month:) %>

<%= simple_form_for(revenue_goals_form, url: revenue_goals_path, method: :patch, html: { class: 'goal-form', data: revenue_goals_form_data }) do |f| %>
  <%= f.hidden_field :month %>

  <div class="card form-card mb-4">
    <div class="form-card-header">
      <p class="form-card-title"><%= t('revenue_goals.form.title') %></p>
      <p class="form-card-subtitle"><%= t('revenue_goals.form.text') %></p>
    </div>
    <div class="form-card-body">
      <div class="row g-3">
        <div class="col-12 col-lg-6">
          <%= f.input :company, as: :money, required: false, hint: t('revenue_goals.form.company_hint'),
                                input_html: { class: 'form-control bg-light', data: { goal_lines_target: 'company' } } %>
        </div>
      </div>
    </div>
  </div>

  <div class="card form-card mb-4" id="revenue_goals_target_fields">
    <div class="form-card-header">
      <p class="form-card-title"><%= t('revenue_goals.form.targets_title') %></p>
      <p class="form-card-subtitle mb-3"><%= t('revenue_goals.form.targets_text', month: goal_month_name(month.prev_month)) %></p>
      <%= goal_tab_nav('revenue_goals_form', revenue_goals_tabs(revenue_goals_form)) %>
    </div>
    <div class="tab-content">
      <%= revenue_goals_form_panes(f, revenue_goals_form, month) %>
    </div>
    <div class="form-card-footer">
      <%= f.button :submit, t('helpers.submit.revenue_goals.update'), class: 'btn btn-primary btn-primary-action px-4 btn-round' %>
      <%= link_to t('helpers.links.cancel'), revenue_goals_path(month: goal_month_param(month)), class: 'btn btn-outline-secondary px-4 btn-round' %>
    </div>
  </div>
<% end %>
