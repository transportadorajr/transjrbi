<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle') do %>
    <%= revenue_goals_panel_button(@month) %>
    <%= revenue_goals_replicate_button(@month) %>
    <%= revenue_goals_edit_button(@month) %>
  <% end %>

  <%= goal_month_nav(@month, :revenue_goals_path) %>

  <div class="row g-2 g-md-3 mb-4 counter-grid-compact" id="revenue_goals_summary">
    <%= revenue_goals_summary_cards(@revenue_goals_form) %>
  </div>

  <div class="card table-card mb-4" id="revenue_goals_targets">
    <div class="table-card-header">
      <div class="table-card-heading mb-3">
        <p class="table-card-title"><%= t('.targets_title', month: goal_month_name(@month)) %></p>
        <p class="table-card-subtitle"><%= t('.targets_subtitle') %></p>
      </div>
      <%= goal_tab_nav('revenue_goals', revenue_goals_tabs(@revenue_goals_form), active: @tab) %>
    </div>
    <div class="tab-content">
      <%= revenue_goals_panes(@pages, @revenue_goals_form, @month, @tab) %>
    </div>
  </div>
</div>
