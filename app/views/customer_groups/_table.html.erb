<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= CustomerGroup.human_attribute_name(:name) %></th>
        <th class="d-none d-md-table-cell"><%= CustomerGroup.human_attribute_name(:customers) %></th>
        <th class="d-none d-lg-table-cell"><%= CustomerGroup.human_attribute_name(:terms) %></th>
        <th><%= CustomerGroup.human_attribute_name(:status) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item:, customer_counts: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
