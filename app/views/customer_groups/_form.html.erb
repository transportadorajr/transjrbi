<div class="card form-card">
  <div class="form-card-header">
    <p class="form-card-title"><%= t('customer_groups.form.customer_group_data') %></p>
    <p class="form-card-subtitle"><%= t('customer_groups.form.customer_group_data_text') %></p>
  </div>
  <%= simple_form_for(customer_group_form, url: customer_group_form_url(customer_group_form)) do |f| %>
    <div class="form-card-body">
      <div class="row g-3">
        <div class="col-12 col-lg-6">
          <%= f.input :name, required: true, input_html: { class: 'form-control', autocomplete: 'off' } %>
        </div>
        <div class="col-12 col-lg-6">
          <%= f.input :terms,
                      as: :text,
                      required: false,
                      hint: t('customer_groups.form.terms_hint'),
                      input_html: { class: 'form-control', rows: 4, autocapitalize: 'characters', autocomplete: 'off', spellcheck: false } %>
        </div>
        <div class="col-12">
          <%= f.input :active,
                      as: :boolean,
                      hint: t('customer_groups.form.active_hint'),
                      input_html: { class: 'form-check-input me-2' } %>
        </div>
      </div>
    </div>

    <div class="form-card-footer">
      <%= f.button :submit, customer_group_form_submit_label(customer_group_form),
                   class: 'btn btn-primary btn-primary-action px-4 btn-round' %>
      <%= link_to t('helpers.links.cancel'), customer_groups_path, class: 'btn btn-outline-secondary px-4 btn-round' %>
    </div>
  <% end %>
</div>
