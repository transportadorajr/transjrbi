<tr id="<%= dom_id(item) %>">
  <td>
    <div class="table-identity">
      <%= link_to tax_value(item.plate), vehicle_path(item), class: 'fw-semibold text-decoration-none text-body text-break' %>
      <span class="text-muted text-small d-block text-break"><%= vehicle_description(item) %></span>
    </div>
  </td>
  <td class="d-none d-md-table-cell"><%= tax_value(item.category) %></td>
  <td class="d-none d-lg-table-cell text-nowrap"><%= vehicle_years(item) %></td>
  <td class="d-none d-md-table-cell"><%= tax_value(item.ownership) %></td>
  <td class="d-none d-lg-table-cell text-break"><%= tax_value(item.driver_name) %></td>
  <td class="text-end text-nowrap">
    <%= responsive_actions_menu(vehicles_menu(item)) %>
  </td>
</tr>
