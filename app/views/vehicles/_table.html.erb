<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= Atua::Vehicle.human_attribute_name(:plate) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::Vehicle.human_attribute_name(:category) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Vehicle.human_attribute_name(:years) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::Vehicle.human_attribute_name(:ownership) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Vehicle.human_attribute_name(:driver_name) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
