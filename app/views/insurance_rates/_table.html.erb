<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= InsuranceRate.human_attribute_name(:valid_from) %></th>
        <th class="d-none d-md-table-cell text-end"><%= InsuranceRate.human_attribute_name(:insurance_percentage) %></th>
        <th class="d-none d-md-table-cell text-end"><%= InsuranceRate.human_attribute_name(:iof_percentage) %></th>
        <th><%= InsuranceRate.human_attribute_name(:status) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item:, current_insurance_rate: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
