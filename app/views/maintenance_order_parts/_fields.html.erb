<%= tag.div class: 'row g-3', data: { controller: 'catalog-fill', catalog_fill_items_value: maintenance_order_part_catalog(item_form).to_json,
                                      action: 'change->catalog-fill#fill' } do %>
  <%= tag.div class: 'col-12', data: { catalog_fill_target: 'source' } do %>
    <%= f.label :maintenance_part_id, for: nil, id: 'maintenance_part_select_label', class: 'form-label' %>
    <%= render 'components/select2', id: 'maintenance_part_select', name: "#{f.object_name}[maintenance_part_id]",
                                     options: maintenance_catalog_options(item_form.maintenance_parts), selected: item_form.maintenance_part_id,
                                     placeholder: t('maintenance_order_parts.form.catalog_placeholder') %>
    <%= tag.div t('maintenance_order_parts.form.catalog_hint'), class: 'form-text' %>
  <% end %>
  <div class="col-12 col-lg-3">
    <%= f.input :code, input_html: { class: 'form-control text-uppercase bg-light', autocomplete: 'off',
                                     data: { catalog_fill_target: 'field', catalog_fill_key: 'code' } } %>
  </div>
  <div class="col-12 col-lg-9">
    <%= f.input :description, required: true, input_html: { class: 'form-control text-uppercase bg-light', autocomplete: 'off',
                                                            data: { catalog_fill_target: 'field', catalog_fill_key: 'description' } } %>
  </div>
  <div class="col-12 col-lg-3">
    <%= f.input :quantity, required: true, input_html: { class: 'form-control bg-light', inputmode: :decimal, autocomplete: 'off' } %>
  </div>
  <div class="col-12 col-lg-3">
    <%= f.input :unit, input_html: { class: 'form-control text-uppercase bg-light', autocomplete: 'off',
                                     data: { catalog_fill_target: 'field', catalog_fill_key: 'unit' } } %>
  </div>
  <div class="col-12 col-lg-6">
    <%= f.input :unit_price, as: :money, input_html: { class: 'form-control bg-light',
                                                       data: { catalog_fill_target: 'field', catalog_fill_key: 'unit_price' } } %>
  </div>
  <div class="col-12 col-lg-6">
    <%= f.input :source_type, collection: MaintenanceOrderPartForm.enum_options_for_select(:source_type), required: true,
                              include_blank: t('helpers.select.prompt'), hint: t('maintenance_order_parts.form.source_type_hint'),
                              input_html: { class: 'form-select bg-light' } %>
  </div>
  <div class="col-12 col-lg-6">
    <%= f.input :document_number, input_html: { class: 'form-control bg-light', autocomplete: 'off' } %>
  </div>
  <div class="col-12">
    <%= f.input :notes, as: :text, input_html: { class: 'form-control bg-light', rows: 2 } %>
  </div>
<% end %>
