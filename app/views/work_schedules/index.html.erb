<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: work_schedule_week_label(@schedule) do %>
    <%= link_to_filters('#filtersModal', class: 'btn btn-outline-secondary btn-round') %>
  <% end %>

  <%= render 'filters', schedule: @schedule %>
  <%= render 'week_navigation', schedule: @schedule %>

  <div class="card table-card">
    <div class="table-card-header">
      <div class="table-card-heading">
        <p class="table-card-title"><%= t('.employees') %></p>
        <p class="table-card-subtitle"><%= t('shared.total_records', count: @employees.total_count) %></p>
      </div>
    </div>
    <div class="table-card-body">
      <% if @rows.any? %>
        <%= render 'table', collection: @employees, rows: @rows, schedule: @schedule %>
      <% else %>
        <%= render 'shared/no_content' %>
      <% end %>
    </div>
  </div>
</div>
