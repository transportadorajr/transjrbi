<% content_for :title, @row.employee.name %>

<div class="page-shell">
  <div class="mb-3 page-breadcrumb">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to t('work_schedules.index.title'), work_schedules_path(week: @schedule.week_start.iso8601) %></li>
        <li class="breadcrumb-item active" aria-current="page"><%= @row.employee.name %></li>
      </ol>
    </nav>
    <%= page_header_tag @row.employee.name, back_path: work_schedules_path(week: @schedule.week_start.iso8601), back_title: t('.back'),
                                            wrapper_class: 'mb-0' do %>
      <%= work_schedule_entry_button(@row.employee, @schedule) %>
    <% end %>
  </div>

  <%= render 'week_navigation', schedule: @schedule, employee: @row.employee %>

  <div class="card detail-card mb-4">
    <div class="detail-card-header">
      <p class="detail-card-title"><%= t('.summary') %></p>
    </div>
    <div class="detail-card-body">
      <dl class="row detail-list mb-0" id="work_schedule_summary">
        <dt class="col-12 col-md-3"><%= Employee.human_attribute_name(:company_type) %></dt>
        <dd class="col-12 col-md-9"><%= @row.employee.company_type_name %></dd>

        <dt class="col-12 col-md-3"><%= t('work_schedules.index.days_off') %></dt>
        <dd class="col-12 col-md-9"><%= work_schedule_days_off_tag(@row) %></dd>

        <dt class="col-12 col-md-3"><%= t('work_schedules.index.sunday') %></dt>
        <dd class="col-12 col-md-9"><%= work_schedule_sunday_tag(@row.sunday) %></dd>

        <dt class="col-12 col-md-3"><%= t('work_schedules.index.alerts_column') %></dt>
        <dd class="col-12 col-md-9"><%= work_schedule_alerts_detail(@row) %></dd>
      </dl>
    </div>
  </div>

  <div class="card detail-card mb-4">
    <div class="detail-card-header">
      <p class="detail-card-title"><%= work_schedule_week_label(@schedule) %></p>
    </div>
    <div class="detail-card-body">
      <ul class="list-unstyled mb-0" id="work_schedule_days">
        <% @row.days.each do |day| %>
          <li class="d-flex justify-content-between align-items-center gap-3 py-2 border-bottom">
            <span class="fw-medium"><%= l(day.date, format: :with_weekday) %></span>
            <span class="text-end"><%= work_schedule_day_cell(day) %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
