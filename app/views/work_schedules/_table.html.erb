<div class="d-lg-none">
  <% rows.each do |row| %>
    <%= render 'card', row:, schedule: %>
  <% end %>
</div>

<div class="table-responsive d-none d-lg-block">
  <table class="table app-table align-middle mb-0" id="work_schedule_table">
    <thead>
      <tr>
        <%= sortable_header(Employee.human_attribute_name(:name), :name) %>
        <% schedule.dates.each do |date| %>
          <th class="text-center"><%= work_schedule_day_label(date) %></th>
        <% end %>
        <th class="text-end"><%= t('work_schedules.index.days_off') %></th>
        <th class="text-end"><%= t('work_schedules.index.sunday') %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <%= render 'row', row:, schedule: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
