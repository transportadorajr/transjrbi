<div class="border-bottom p-3" id="<%= dom_id(row.employee, :card) %>">
  <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
    <%= link_to row.employee.name, work_schedule_path(row.employee, week: schedule.week_start.iso8601), class: 'fw-semibold text-reset text-break' %>
    <div class="d-flex flex-column align-items-end gap-1">
      <%= work_schedule_days_off_tag(row) %>
      <%= work_schedule_sunday_tag(row.sunday) %>
    </div>
  </div>
  <%= work_schedule_alerts_tag(row, wrapper_class: 'd-flex flex-wrap gap-1 mb-2') %>
  <div class="d-flex justify-content-end mt-2">
    <%= responsive_actions_menu(work_schedule_menu(row.employee, schedule)) %>
  </div>
</div>
