<%= auth_header_tag t('.change_your_password') %>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: 'auth-form' }) do |f| %>
  <%= render 'devise/shared/error_messages', resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="form-floating mb-3">
    <%= f.password_field :password, autofocus: true, autocomplete: 'new-password',
                                    placeholder: t('.new_password'), class: 'form-control auth-input' %>
    <%= f.label :password, t('.new_password') %>
  </div>

  <div class="form-floating mb-1">
    <%= f.password_field :password_confirmation, autocomplete: 'new-password',
                                                 placeholder: t('.confirm_new_password'), class: 'form-control auth-input' %>
    <%= f.label :password_confirmation, t('.confirm_new_password') %>
  </div>

  <% if @minimum_password_length %>
    <div class="form-text mb-4"><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></div>
  <% end %>

  <%= f.submit t('.change_my_password'), class: 'btn auth-btn w-100' %>
<% end %>

<%= render 'devise/shared/links' %>
