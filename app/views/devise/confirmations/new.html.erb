<%= auth_header_tag t('.resend_confirmation_instructions') %>

<%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: 'auth-form' }) do |f| %>
  <%= render 'devise/shared/error_messages', resource: resource %>

  <div class="form-floating mb-4">
    <%= f.email_field :email, autofocus: true, autocomplete: 'email', inputmode: 'email',
                              placeholder: User.human_attribute_name(:email), class: 'form-control auth-input',
                              value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) %>
    <%= f.label :email %>
  </div>

  <%= f.submit t('.resend_confirmation_instructions'), class: 'btn auth-btn w-100' %>
<% end %>

<%= render 'devise/shared/links' %>
