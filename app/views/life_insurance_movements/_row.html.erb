<tr id="<%= dom_id(item) %>">
  <td class="fw-semibold text-break"><%= item.employee.name %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= item.life_insurance_policy.company_type_name %></td>
  <td><%= life_insurance_movement_badge(item) %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= l(item.occurred_on) %></td>
  <td class="d-none d-lg-table-cell text-end text-nowrap"><%= tax_money(item.capital) %></td>
  <td class="d-none d-lg-table-cell text-end text-nowrap"><%= tax_money(item.premium) %></td>
</tr>
