<% content_for :title, t('.title') %>

<div class="page-shell">
  <%= page_header_tag t('.title'), subtitle: t('.subtitle') do %>
    <%= link_to_filters('#filtersModal', class: 'btn btn-outline-secondary btn-round') %>
    <%= xlsx_export_button %>
  <% end %>

  <%= render 'filters' %>

  <%= render 'month_navigation', month: @month %>

  <div class="row g-3 mb-4">
    <%= life_insurance_movement_counters(@kind_counts) %>
  </div>

  <div class="card table-card">
    <div class="table-card-header">
      <div class="table-card-heading">
        <p class="table-card-title"><%= life_insurance_movements_month_title(@month) %></p>
        <p class="table-card-subtitle"><%= t('shared.total_records', count: @movements.total_count) %></p>
      </div>
    </div>
    <div class="table-card-body">
      <% if @movements.any? %>
        <%= render 'table', collection: @movements %>
      <% else %>
        <%= render 'shared/no_content' %>
      <% end %>
    </div>
  </div>
</div>
