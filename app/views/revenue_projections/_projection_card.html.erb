<%# locals: (projection:, id:) %>

<div class="col-12 col-lg-6">
  <div class="card detail-card h-100">
    <div class="detail-card-header">
      <p class="detail-card-title"><%= revenue_projection_title(projection) %></p>
    </div>
    <div class="detail-card-body">
      <dl class="row detail-list mb-0" id="<%= id %>">
        <dt class="col-12 col-sm-6"><%= revenue_projection_realized_label(projection) %></dt>
        <dd class="col-12 col-sm-6 text-sm-end"><%= tax_money(projection.realized) %></dd>

        <dt class="col-12 col-sm-6"><%= revenue_projection_deadline_label(projection) %></dt>
        <dd class="col-12 col-sm-6 text-sm-end fs-4 fw-bold text-primary"><%= tax_money(projection.projected) %></dd>

        <dt class="col-12 col-sm-6"><%= t('revenue_projections.show.range') %></dt>
        <dd class="col-12 col-sm-6 text-sm-end"><%= revenue_projection_range(projection) %></dd>
      </dl>

      <%= revenue_projection_alerts(projection) %>
    </div>
  </div>
</div>
