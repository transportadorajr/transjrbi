<%# locals: (rows:) %>

<div class="table-responsive">
  <table class="table table-sm app-table align-middle mb-0" id="memory_factors">
    <thead>
      <tr>
        <th><%= t('revenue_projections.memory.factor') %></th>
        <th class="text-end"><%= t('revenue_projections.memory.value') %></th>
        <th class="text-end d-none d-md-table-cell"><%= t('revenue_projections.memory.observations') %></th>
        <th class="text-end"><%= t('revenue_projections.memory.status') %></th>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <%= render 'memory_factor_row', row: %>
      <% end %>
    </tbody>
  </table>
</div>
