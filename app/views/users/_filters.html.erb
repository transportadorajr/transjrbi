<div class="modal fade" id="filtersModal" tabindex="-1" aria-labelledby="filtersModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen-sm-down">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title h5" id="filtersModalLabel">
          <%= icon(:filter, class: 'me-2 text-primary') %>
          <%= t('shared.filters') %>
        </h5>
        <%= button_tag '', type: 'button', class: 'btn-close', data: { bs_dismiss: 'modal' }, aria: { label: t('shared.close') } %>
      </div>

      <div class="modal-body">
        <%= form_with url: users_path, method: :get do |f| %>
          <div class="row g-3">
            <div class="col-12">
              <%= f.label :name, t('users.filters.name'), class: 'form-label fw-medium' %>
              <%= f.text_field :name, value: params[:name], class: 'form-control bg-light', placeholder: t('users.filters.name') %>
            </div>

            <div class="col-12">
              <%= f.label :status, t('users.filters.status'), class: 'form-label fw-medium' %>
              <%= f.select :status,
                           User.statuses,
                           { include_blank: t('shared.all'), selected: params[:status] },
                           { class: 'form-select bg-light' } %>
            </div>
          </div>

          <div class="d-flex flex-column gap-2 mt-4">
            <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
            <%= link_to t('shared.clear_filters'), users_path, class: 'btn btn-light w-100 btn-round' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
