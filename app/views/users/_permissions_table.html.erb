<div class="table-responsive">
  <table class="table table-hover align-middle mb-0" id="user_permissions">
    <thead class="table-light">
      <tr>
        <th><%= Access.human_attribute_name(:resource) %></th>
        <th class="text-center"><%= Access.human_attribute_name(:reads) %></th>
        <th class="text-center"><%= Access.human_attribute_name(:creates) %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'users/permissions_row', collection: accesses, as: :access %>
    </tbody>
  </table>
</div>
