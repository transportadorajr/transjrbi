<div class="permissions-card">
  <div class="permissions-card-header">
    <h3 class="permissions-card-title"><%= t('users.form.password_title') %></h3>
    <p class="permissions-card-text"><%= t('users.form.password_text') %></p>
  </div>

  <div class="row g-3">
    <div class="col-12 col-lg-6">
      <%= f.input :password,
                  as: :password,
                  required: false,
                  hint: t('devise.shared.minimum_password_length', count: Devise.password_length.min),
                  input_html: { class: 'form-control', autocomplete: 'new-password' } %>
    </div>
    <div class="col-12 col-lg-6">
      <%= f.input :password_confirmation,
                  as: :password,
                  required: false,
                  input_html: { class: 'form-control', autocomplete: 'new-password' } %>
    </div>
    <div class="col-12">
      <%= f.input :password_change_required,
                  as: :boolean,
                  hint: t('users.form.password_change_required_hint'),
                  input_html: { class: 'form-check-input me-2' } %>
    </div>
  </div>
</div>
