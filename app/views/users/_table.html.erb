<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= User.human_attribute_name(:name) %></th>
        <th class="d-none d-lg-table-cell"><%= User.human_attribute_name(:phone) %></th>
        <th class="d-none d-md-table-cell"><%= User.human_attribute_name(:user_type) %></th>
        <th><%= User.human_attribute_name(:status) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
