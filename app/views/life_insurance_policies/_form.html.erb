<div class="card form-card">
  <div class="form-card-header">
    <p class="form-card-title"><%= t('life_insurance_policies.form.policy_data') %></p>
    <p class="form-card-subtitle"><%= t('life_insurance_policies.form.policy_data_text') %></p>
  </div>
  <%= simple_form_for(life_insurance_policy_form, url: life_insurance_policy_form_url(life_insurance_policy_form)) do |f| %>
    <div class="form-card-body">
      <div class="row g-3">
        <div class="col-12 col-lg-4">
          <%= life_insurance_policy_company_field(f, life_insurance_policy_form) %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.input :capital, as: :string, required: true, hint: t('life_insurance_policies.form.capital_hint'),
                                input_html: { class: 'form-control', inputmode: 'decimal', autocomplete: 'off' } %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.input :premium_rate_per_mille, as: :string, required: true, hint: t('life_insurance_policies.form.premium_rate_hint'),
                                               input_html: { class: 'form-control', inputmode: 'decimal', autocomplete: 'off' } %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.input :spouse_percentage, as: :string, required: true,
                                          input_html: { class: 'form-control', inputmode: 'decimal', autocomplete: 'off' } %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.input :children_percentage, as: :string, required: true,
                                            input_html: { class: 'form-control', inputmode: 'decimal', autocomplete: 'off' } %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.input :funeral_assistance, as: :string, required: true,
                                           input_html: { class: 'form-control', inputmode: 'decimal', autocomplete: 'off' } %>
        </div>
      </div>
    </div>

    <div class="form-card-footer">
      <%= f.button :submit, life_insurance_policy_form_submit_label(life_insurance_policy_form),
                   class: 'btn btn-primary btn-primary-action px-4 btn-round' %>
      <%= link_to t('helpers.links.cancel'), life_insurance_policies_path, class: 'btn btn-outline-secondary px-4 btn-round' %>
    </div>
  <% end %>
</div>
