<div class="table-responsive">
  <table class="table table-hover align-middle mb-0" id="transport_document_expenses">
    <thead class="table-light">
      <tr>
        <th><%= Atua::Expense.human_attribute_name(:history_name) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::Expense.human_attribute_name(:posted_on) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::Expense.human_attribute_name(:payee_name) %></th>
        <th class="text-end"><%= Atua::Expense.human_attribute_name(:total) %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'transport_documents/expenses/row', collection: expenses, as: :expense %>
    </tbody>
  </table>
</div>
<div class="d-flex justify-content-between align-items-center border-top pt-3 mt-3" id="transport_document_expenses_total">
  <span class="fw-medium"><%= t('transport_documents.expenses.total') %></span>
  <strong class="text-nowrap"><%= tax_money(total) %></strong>
</div>
