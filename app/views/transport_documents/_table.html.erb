<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= Atua::TransportDocument.human_attribute_name(:number) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::TransportDocument.human_attribute_name(:issued_at) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::TransportDocument.human_attribute_name(:route) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::TransportDocument.human_attribute_name(:plate) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::TransportDocument.human_attribute_name(:freight) %></th>
        <th><%= Atua::TransportDocument.human_attribute_name(:situation) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
