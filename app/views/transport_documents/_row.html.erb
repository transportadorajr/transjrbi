<tr id="<%= dom_id(item) %>">
  <td>
    <div class="table-identity">
      <%= link_to item.number, transport_document_path(item), class: 'fw-semibold text-decoration-none text-body text-break' %>
      <span class="text-muted text-small d-block text-break"><%= tax_value(item.sender_name) %></span>
    </div>
  </td>
  <td class="d-none d-md-table-cell text-nowrap"><%= tax_date(item.posted_on) %></td>
  <td class="d-none d-xl-table-cell"><%= transport_document_route(item) %></td>
  <td class="d-none d-xl-table-cell text-nowrap"><%= tax_value(item.plate) %></td>
  <td class="d-none d-lg-table-cell text-break"><%= tax_value(item.taker_name) %></td>
  <td class="d-none d-lg-table-cell text-break"><%= tax_value(item.driver_name) %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= tax_money(item.freight) %></td>
  <%= freight_net_cell(item, class: 'd-none d-md-table-cell text-nowrap') %>
  <td><%= tax_situation_badge(item) %></td>
  <td class="text-end text-nowrap">
    <%= responsive_actions_menu(transport_documents_menu(item)) %>
  </td>
</tr>
