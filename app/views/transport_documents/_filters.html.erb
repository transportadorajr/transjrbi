<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: transport_documents_path, method: :get do |f| %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :number, t('transport_documents.filters.number'), class: 'form-label fw-medium' %>
        <%= f.text_field :number, value: params[:number], class: 'form-control bg-light', inputmode: :numeric,
                                  placeholder: t('transport_documents.filters.number') %>
      </div>

      <div class="col-12">
        <%= f.label :plate, t('transport_documents.filters.plate'), class: 'form-label fw-medium' %>
        <%= f.text_field :plate, value: params[:plate], class: 'form-control bg-light text-uppercase', autocomplete: :off,
                                 placeholder: t('transport_documents.filters.plate') %>
      </div>

      <div class="col-12">
        <%= f.label :driver_code, t('transport_documents.filters.driver_code'), for: nil, id: 'driver_code_select_label', class: 'form-label fw-medium' %>
        <%= render 'components/select2', id: 'driver_code_select', name: :driver_code, options: freight_billing_driver_options(@drivers),
                                         selected: params[:driver_code], placeholder: t('shared.all') %>
      </div>

      <%= tag.div class: 'col-12', data: { controller: 'dependent-frame', dependent_frame_url_value: customer_options_transport_documents_path,
                                           dependent_frame_param_value: 'customer_group_id', dependent_frame_selected_param_value: 'customer_code' } do %>
        <%= f.label :customer_group_id, t('transport_documents.filters.customer_group_id'), for: nil, id: 'customer_group_id_select_label', class: 'form-label fw-medium' %>
        <%= tag.div data: { action: 'change->dependent-frame#reload' }, class: 'mb-3' do %>
          <%= render 'components/select2', id: 'customer_group_id_select', name: :customer_group_id,
                                           options: freight_billing_customer_group_options(@customer_groups),
                                           selected: params[:customer_group_id], placeholder: t('shared.all') %>
        <% end %>

        <%= f.label :customer_code, t('transport_documents.filters.customer_code'), for: nil, id: 'customer_code_select_label', class: 'form-label fw-medium' %>
        <%= turbo_frame_tag 'customer_options', src: customer_options_transport_documents_path(params.permit(:customer_group_id, :customer_code)),
                                                loading: :lazy, data: { dependent_frame_target: 'frame' } do %>
          <%= hidden_field_tag :customer_code, params[:customer_code], id: nil %>
          <%= tag.div t('shared.all'), class: 'form-select bg-light' %>
        <% end %>
      <% end %>

      <div class="col-12">
        <%= f.label :status, t('transport_documents.filters.status'), class: 'form-label fw-medium' %>
        <%= f.select :status,
                     Atua::TransportDocument.statuses,
                     { include_blank: t('shared.all'), selected: params[:status] },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :start_date, t('transport_documents.filters.start_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :start_date, value: params[:start_date], class: 'form-control bg-light' %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :end_date, t('transport_documents.filters.end_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :end_date, value: params[:end_date], class: 'form-control bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), transport_documents_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
