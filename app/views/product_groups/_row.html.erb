<tr id="<%= dom_id(item) %>">
  <td>
    <%= link_to item.name, product_group_path(item), class: 'fw-semibold text-decoration-none text-body text-break' %>
  </td>
  <td class="d-none d-md-table-cell"><%= product_group_count(item, subgroup_counts) %></td>
  <td class="d-none d-lg-table-cell"><%= number_with_delimiter(product_group_count(item, document_counts)) %></td>
  <td><%= product_group_status_badge(item) %></td>
  <td class="text-end text-nowrap">
    <%= responsive_actions_menu(product_groups_menu(item)) %>
  </td>
</tr>
