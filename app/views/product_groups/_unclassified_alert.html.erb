<div class="alert alert-warning mb-4" role="alert" id="unclassified_products_alert">
  <p class="fw-semibold mb-1"><%= t('product_groups.unclassified_alert.title', count: products.size) %></p>
  <p class="mb-2"><%= t('product_groups.unclassified_alert.text') %></p>
  <ul class="mb-0 ps-3">
    <% products.each do |product_name, count| %>
      <li>
        <%= product_name %>
        <span class="text-body-secondary"><%= t('product_groups.unclassified_alert.documents', count:) %></span>
      </li>
    <% end %>
  </ul>
</div>
