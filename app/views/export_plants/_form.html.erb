<div class="card form-card">
  <div class="form-card-header">
    <p class="form-card-title"><%= t('export_plants.form.export_plant_data') %></p>
    <p class="form-card-subtitle"><%= t('export_plants.form.export_plant_data_text') %></p>
  </div>
  <%= simple_form_for(export_plant_form, url: export_plant_form_url(export_plant_form)) do |f| %>
    <div class="form-card-body">
      <div class="row g-3">
        <div class="col-12 col-lg-6">
          <%= f.input :customer_group_id, collection: export_plant_form.customer_groups, label_method: :name, value_method: :id,
                                          required: true, include_blank: t('helpers.select.prompt'),
                                          input_html: { class: 'form-select' } %>
        </div>
        <div class="col-12 col-lg-6">
          <%= f.input :name, required: true, hint: t('export_plants.form.name_hint'), input_html: { class: 'form-control', autocomplete: 'off' } %>
        </div>
        <div class="col-12">
          <%= f.input :cities,
                      as: :text,
                      required: true,
                      hint: t('export_plants.form.cities_hint'),
                      input_html: { class: 'form-control', rows: 4, autocomplete: 'off', spellcheck: false } %>
        </div>
        <div class="col-12">
          <%= f.input :active,
                      as: :boolean,
                      hint: t('export_plants.form.active_hint'),
                      input_html: { class: 'form-check-input me-2' } %>
        </div>
      </div>
    </div>

    <div class="form-card-footer">
      <%= f.button :submit, export_plant_form_submit_label(export_plant_form),
                   class: 'btn btn-primary btn-primary-action px-4 btn-round' %>
      <%= link_to t('helpers.links.cancel'), export_plants_path, class: 'btn btn-outline-secondary px-4 btn-round' %>
    </div>
  <% end %>
</div>
