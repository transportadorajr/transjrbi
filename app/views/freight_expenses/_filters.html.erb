<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: freight_expenses_path, method: :get do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :number, t('freight_expenses.filters.number'), class: 'form-label fw-medium' %>
        <%= f.text_field :number, value: params[:number], class: 'form-control bg-light', autocomplete: :off, inputmode: :numeric,
                                  placeholder: t('freight_expenses.filters.number') %>
      </div>

      <div class="col-12">
        <%= f.label :kind, t('freight_expenses.filters.kind'), class: 'form-label fw-medium' %>
        <%= f.select :kind,
                     FreightExpense.kinds,
                     { include_blank: t('shared.all'), selected: params[:kind] },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :customer_group_id, t('freight_expenses.filters.customer_group'), class: 'form-label fw-medium' %>
        <%= f.collection_select :customer_group_id, @customer_groups, :id, :name,
                                { include_blank: t('shared.all'), selected: params[:customer_group_id] },
                                { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :start_date, t('freight_expenses.filters.start_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :start_date, value: params[:start_date], class: 'form-control bg-light' %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :end_date, t('freight_expenses.filters.end_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :end_date, value: params[:end_date], class: 'form-control bg-light' %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), freight_expenses_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
