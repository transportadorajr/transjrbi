<div class="alert alert-warning mb-4" role="alert" id="unmatched_foreign_documents">
  <p class="fw-semibold mb-1"><%= t('freight_expenses.unmatched_alert.title', count: transport_documents.size) %></p>
  <p class="mb-2"><%= t('freight_expenses.unmatched_alert.text') %></p>
  <ul class="mb-0 ps-3">
    <% transport_documents.each do |transport_document| %>
      <li>
        <%= freight_expense_transport_document(transport_document) %>
        <span class="text-body-secondary">
          <%= tax_city(transport_document.destination_city, transport_document.destination_state) %>
        </span>
      </li>
    <% end %>
  </ul>
</div>
