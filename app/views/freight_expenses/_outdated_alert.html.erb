<div class="alert alert-warning mb-4" role="alert" id="outdated_tonnage_rates">
  <p class="fw-semibold mb-1"><%= t('freight_expenses.outdated_alert.title', count: tonnage_rates.size) %></p>
  <p class="mb-2"><%= t('freight_expenses.outdated_alert.text') %></p>
  <ul class="mb-0 ps-3">
    <% tonnage_rates.each do |tonnage_rate| %>
      <li>
        <%= freight_expense_tonnage_rate(tonnage_rate) %>
        <span class="text-body-secondary"><%= tonnage_rate_month(tonnage_rate.valid_month) %></span>
      </li>
    <% end %>
  </ul>
</div>
