<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= FreightExpense.human_attribute_name(:transport_document) %></th>
        <th class="d-none d-md-table-cell"><%= Atua::TransportDocument.human_attribute_name(:issued_at) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::TransportDocument.human_attribute_name(:taker) %></th>
        <th class="d-none d-lg-table-cell"><%= Atua::TransportDocument.human_attribute_name(:destination) %></th>
        <th class="d-none d-md-table-cell"><%= FreightExpense.human_attribute_name(:commission_rule) %></th>
        <th class="d-none d-lg-table-cell text-end"><%= FreightExpense.human_attribute_name(:base) %></th>
        <th class="d-none d-md-table-cell text-end"><%= FreightExpense.human_attribute_name(:percentage) %></th>
        <th class="text-end"><%= FreightExpense.human_attribute_name(:amount) %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |item| %>
        <%= render 'row', item: %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="table-pagination">
  <%= paginate collection %>
</div>
