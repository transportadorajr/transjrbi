<%# locals: (dashboard:, rows:) %>

<div class="table-responsive">
  <table class="table app-table align-middle mb-0">
    <thead>
      <tr>
        <th><%= t('export_summaries.columns.plant') %></th>
        <th class="d-none d-md-table-cell"><%= t('export_summaries.columns.country') %></th>
        <th class="text-end"><%= t('export_summaries.columns.tons') %></th>
        <th class="d-none d-md-table-cell text-end"><%= t('export_summaries.columns.loadings') %></th>
        <th class="d-none d-lg-table-cell text-end"><%= t('export_summaries.columns.documents') %></th>
        <th class="d-none d-md-table-cell text-end"><%= t('export_summaries.columns.share') %></th>
        <th class="text-end"><%= t('shared.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'row', collection: rows, as: :row %>
    </tbody>
    <tfoot>
      <%= render 'row', row: dashboard.total %>
    </tfoot>
  </table>
</div>

<div class="table-pagination">
  <%= paginate rows, params: { anchor: 'export_summary_table' } %>
</div>
