<%# locals: (dashboard:) %>

<div class="d-flex flex-column mb-4" id="export_summary_evolution">
  <%= render 'shared/evolution_filter', label: t('export_summaries.show.evolution_label') %>

  <%= export_summary_evolution_cards(dashboard) %>
</div>

<div class="card table-card" id="export_summary_table">
  <div class="table-card-header">
    <div class="table-card-heading">
      <p class="table-card-title"><%= t('export_summaries.show.table_title') %></p>
      <p class="table-card-subtitle"><%= t('export_summaries.show.table_subtitle') %></p>
    </div>
  </div>
  <div class="table-card-body">
    <%= render 'table', dashboard:, rows: @rows %>
  </div>
</div>
