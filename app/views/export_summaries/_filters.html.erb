<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: export_summary_path, method: :get, data: { controller: 'date-range' } do |f| %>
    <%= export_summary_shortcut_hidden_field(f, @filter_form) %>
    <div class="row g-3">
      <div class="col-12 col-lg-6">
        <%= f.label :start_date, ExportSummaryFilterForm.human_attribute_name(:start_date), class: 'form-label fw-medium' %>
        <%= f.date_field :start_date, value: @filter_form.start_date, class: 'form-control bg-light',
                                      data: { date_range_target: 'start', action: 'change->date-range#openEnd' } %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :end_date, ExportSummaryFilterForm.human_attribute_name(:end_date), class: 'form-label fw-medium' %>
        <%= f.date_field :end_date, value: @filter_form.end_date, class: 'form-control bg-light', data: { date_range_target: 'end' } %>
      </div>

      <div class="col-12">
        <%= f.label :customer_group_id, ExportSummaryFilterForm.human_attribute_name(:customer_group_id), class: 'form-label fw-medium' %>
        <%= f.select :customer_group_id, export_summary_customer_group_options(@dashboard),
                     { include_blank: t('shared.all'), selected: @filter_form.customer_group_id },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :plant, ExportSummaryFilterForm.human_attribute_name(:plant), class: 'form-label fw-medium' %>
        <%= f.select :plant, @dashboard.plant_options, { include_blank: t('shared.all'), selected: @filter_form.plant },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :country, ExportSummaryFilterForm.human_attribute_name(:country), class: 'form-label fw-medium' %>
        <%= f.select :country, @dashboard.country_options, { include_blank: t('shared.all'), selected: @filter_form.country },
                     { class: 'form-select bg-light' } %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), name: nil, class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), export_summary_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
