<%= render layout: 'components/new_modal',
           locals: { id: 'filtersModal', title: t('shared.filters'), title_icon: :filter,
                     dialog_class: 'modal-fullscreen-sm-down', show_footer: false } do %>
  <%= form_with url: advance_icms_path, method: :get, data: { controller: 'date-range' } do |f| %>
    <%= sort_fields %>
    <div class="row g-3">
      <div class="col-12">
        <%= f.label :number, t('advance_icms.filters.number'), class: 'form-label fw-medium' %>
        <%= f.text_field :number, value: params[:number], class: 'form-control bg-light', autocomplete: :off, inputmode: :numeric,
                                  placeholder: t('advance_icms.filters.number') %>
      </div>

      <div class="col-12">
        <%= f.label :status, t('advance_icms.filters.status'), class: 'form-label fw-medium' %>
        <%= f.select :status, advance_icms_status_options, { include_blank: t('shared.all') }, { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <div class="form-check">
          <%= f.check_box :overdue, { checked: params[:overdue].present?, class: 'form-check-input' }, '1', nil %>
          <%= f.label :overdue, t('advance_icms.filters.overdue'), class: 'form-check-label fw-medium' %>
        </div>
      </div>

      <div class="col-12">
        <%= f.label :customer_group_id, t('advance_icms.filters.customer_group'), class: 'form-label fw-medium' %>
        <%= f.select :customer_group_id, advance_icms_customer_group_options(@customer_groups), { include_blank: t('shared.all') },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12">
        <%= f.label :origin_state, t('advance_icms.filters.origin_state'), class: 'form-label fw-medium' %>
        <%= f.select :origin_state, @origin_states, { include_blank: t('shared.all'), selected: params[:origin_state] },
                     { class: 'form-select bg-light' } %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :start_date, t('advance_icms.filters.start_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :start_date, value: params[:start_date], class: 'form-control bg-light',
                                      data: { date_range_target: 'start', action: 'change->date-range#openEnd' } %>
      </div>

      <div class="col-12 col-lg-6">
        <%= f.label :end_date, t('advance_icms.filters.end_date'), class: 'form-label fw-medium' %>
        <%= f.date_field :end_date, value: params[:end_date], class: 'form-control bg-light', data: { date_range_target: 'end' } %>
      </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
      <%= f.button t('shared.apply_filters'), class: 'btn btn-primary w-100 btn-round' %>
      <%= link_to t('shared.clear_filters'), advance_icms_path, class: 'btn btn-light w-100 btn-round' %>
    </div>
  <% end %>
<% end %>
