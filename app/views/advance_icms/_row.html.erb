<tr id="<%= dom_id(item) %>">
  <td><%= advance_icms_transport_document(item) %></td>
  <td class="d-none d-md-table-cell text-nowrap"><%= tax_time(item.issued_at) %></td>
  <td class="d-none d-lg-table-cell text-break"><%= tax_value(item.taker_name) %></td>
  <td class="d-none d-lg-table-cell text-break"><%= tax_city(item.origin_city, item.origin_state) %></td>
  <td class="d-none d-md-table-cell text-end text-nowrap"><%= tax_money(item.icms) %></td>
  <td class="d-none d-md-table-cell text-end text-nowrap"><%= tax_money(item.advance_icms_guide) %></td>
  <td class="d-none d-lg-table-cell text-end text-nowrap"><%= advance_icms_difference(item) %></td>
  <td class="text-nowrap"><%= advance_icms_status_badge(item) %></td>
  <td class="text-end text-nowrap">
    <%= responsive_actions_menu(advance_icms_menu(item)) %>
  </td>
</tr>
