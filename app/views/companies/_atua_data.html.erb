<div class="form-card-header">
  <p class="form-card-title"><%= t('companies.form.atua_data') %></p>
  <p class="form-card-subtitle"><%= t('companies.form.atua_data_text') %></p>
</div>
<div class="form-card-body">
  <div class="row g-3">
    <div class="col-12">
      <%= f.input :atua_url, as: :url, required: false, hint: t('companies.form.atua_url_hint'),
                             input_html: { class: 'form-control', autocomplete: 'off' } %>
    </div>
    <div class="col-12 col-lg-6">
      <%= f.input :atua_device_token, as: :password, required: false, hint: t('companies.form.secret_hint'),
                                      input_html: { class: 'form-control', autocomplete: 'off' } %>
    </div>
    <div class="col-12 col-lg-6">
      <%= f.input :atua_device_hash, as: :password, required: false, hint: t('companies.form.secret_hint'),
                                     input_html: { class: 'form-control', autocomplete: 'off' } %>
    </div>
  </div>
</div>
