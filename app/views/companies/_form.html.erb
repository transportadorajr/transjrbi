<%= simple_form_for(company_form, url: company_path, method: :patch) do |f| %>
  <%= render 'companies/company_data', f: %>

  <div class="card form-card">
    <%= render 'companies/atua_data', f: %>

    <div class="form-card-footer">
      <%= f.button :submit, t('helpers.submit.company.update'), class: 'btn btn-primary btn-primary-action px-4 btn-round' %>
      <%= link_to t('helpers.links.cancel'), company_path, class: 'btn btn-outline-secondary px-4 btn-round' %>
    </div>
  </div>
<% end %>
