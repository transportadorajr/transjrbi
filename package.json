{
  "name": "transjrbi",
  "private": true,
  "scripts": {
    "build": "bun bun.config.js",
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps --silence-deprecation=import",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --use=autoprefixer --output=./app/assets/builds/application.css",
    "build:css": "bun run build:css:compile && bun run build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"bun run build:css\""
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@popperjs/core": "^2.11.8",
    "autoprefixer": "^10.6.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.29",
    "postcss-cli": "^12.0.0",
    "sass": "^1.105.1"
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "prettier": "^3.9.9"
  }
}
