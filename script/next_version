#!/bin/bash

set -euo pipefail

tag_pattern='v[0-9]*.[0-9]*.[0-9]*'

current_tag=$(git tag --points-at HEAD --list "$tag_pattern" | sort -V | tail -n 1)
if [ -n "$current_tag" ]; then
  echo "${current_tag#v}"
  exit 0
fi

last_tag=$(git describe --tags --abbrev=0 --match "$tag_pattern" 2>/dev/null || true)
if [ -z "$last_tag" ]; then
  echo '1.0.0'
  exit 0
fi

labels=$(
  git rev-list "$last_tag..HEAD" | while read -r sha; do
    gh api "repos/{owner}/{repo}/commits/$sha/pulls" --jq '.[].labels[].name'
  done | sort -u
)

IFS=. read -r major minor patch <<< "${last_tag#v}"

if grep -qx 'major' <<< "$labels"; then
  echo "$((major + 1)).0.0"
elif grep -qx 'minor' <<< "$labels"; then
  echo "$major.$((minor + 1)).0"
else
  echo "$major.$minor.$((patch + 1))"
fi
